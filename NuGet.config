<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- The local feed holds KoLibri.Core, which the LibKolibri submodule
         references as a package. Until the core is published to nuget.org,
         pack it there:
           dotnet pack src/KoLibri.Core/KoLibri.Core.csproj \
             -c Release -o ~/.nuget/local-feed
         and point the path below at your local feed directory. -->
    <add key="local-feed" value="/home/tomka/.nuget/local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
