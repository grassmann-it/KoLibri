<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>kolibri</ToolCommandName>
    <PackageId>KoLibri.Cli</PackageId>
    <Description>Command line for Kingdom of Loathing: login, account reads, mall, daily routine, adventures. Preview by default; writes need --execute.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/KoLibri.Core/KoLibri.Core.csproj" />
    <ProjectReference Include="../../src/LibKolibri/src/LibKolibri/LibKolibri.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)../../external/kolmafia-data/**/*" CopyToOutputDirectory="PreserveNewest" LinkBase="external/kolmafia-data" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="KoLibri.Core.Tests" />
  </ItemGroup>
</Project>
