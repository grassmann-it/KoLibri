<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>kolibri</ToolCommandName>
    <PackageId>KoLibri.Cli</PackageId>
    <Description>Command line for Kingdom of Loathing: login, account reads, mall, daily routine, adventures, choices, consume, cast and rest. Preview by default; writes need --execute.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <!-- 0.5: the CLI is built on the public KoLibri API only (no KoLibri.Core, no LibKolibri).
         PrivateAssets keeps the library types out of projects that reference the CLI (the Core test suite). -->
    <ProjectReference Include="../../src/KoLibri/KoLibri.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../src/KoLibri.Safety/KoLibri.Safety.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../src/KoLibri.Daily/KoLibri.Daily.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../src/KoLibri.Extras/KoLibri.Extras.csproj" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)../../external/kolmafia-data/**/*" CopyToOutputDirectory="PreserveNewest" LinkBase="external/kolmafia-data" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="KoLibri.Core.Tests" />
    <InternalsVisibleTo Include="KoLibri.Tests" />
  </ItemGroup>
</Project>
