<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>kolibri-mcp</ToolCommandName>
    <PackageId>KoLibri.Mcp</PackageId>
    <Description>MCP server that lets an AI assistant read a Kingdom of Loathing account, adventure and fight, use items, search and buy in the mall and send KMail, each write approved by you.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <!-- 0.5: the MCP server is built on the public KoLibri API (no KoLibri.Core, no LibKolibri).
         PrivateAssets keeps the library types out of projects that reference the server (the Core test suite). -->
    <ProjectReference Include="../../src/KoLibri/KoLibri.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../src/KoLibri.Safety/KoLibri.Safety.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../src/KoLibri.Daily/KoLibri.Daily.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../src/KoLibri.Extras/KoLibri.Extras.csproj" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)../../external/kolmafia-data/**/*" CopyToOutputDirectory="PreserveNewest" LinkBase="external/kolmafia-data" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="KoLibri.Tests" />
  </ItemGroup>
</Project>
