<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>kolibri-mcp</ToolCommandName>
    <PackageId>KoLibri.Mcp</PackageId>
    <Version>0.1.0-preview</Version>
    <Authors>grassmann-it</Authors>
    <Description>MCP server that lets an AI assistant read a Kingdom of Loathing account, search the mall, plan the daily routine and, with approval, adventure.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/KolArbitrage.Core/KolArbitrage.Core.csproj" />
    <ProjectReference Include="../../src/LibKolibri/src/LibKolibri/LibKolibri.csproj" />
  </ItemGroup>
</Project>
