<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KoLibri.Desktop"
             x:Class="KoLibri.Desktop.SkillsEffectsView">
  <UserControl.Styles>
    <Style Selector="ListBox.compact ListBoxItem"><Setter Property="Padding" Value="6,2" /><Setter Property="MinHeight" Value="0" /></Style>
  </UserControl.Styles>
  <Border Classes="card">
    <StackPanel Spacing="12">
      <TextBlock Text="Skills" Classes="h3" />
      <TextBlock x:Name="CharacterResourceStatus" TextWrapping="Wrap" />
      <TextBox x:Name="SkillFilterBox" Watermark="Filter skills by name" Width="260" HorizontalAlignment="Left" />
      <ListBox x:Name="SkillList" Classes="compact" Height="190" MaxWidth="520" HorizontalAlignment="Left">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="local:SkillRow">
            <TextBlock Text="{Binding Display}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <WrapPanel>
        <TextBlock Text="Casts" VerticalAlignment="Center" Margin="0,0,6,0" />
        <NumericUpDown x:Name="SkillQuantity" Minimum="1" Maximum="999" Value="1" Width="110" FormatString="0" />
        <Button x:Name="SkillCastButton" Content="Cast…" Click="SkillCastClick" />
      </WrapPanel>
      <Border x:Name="SkillConfirmPanel" IsVisible="False" Classes="card" Padding="8">
        <StackPanel Spacing="6">
          <TextBlock x:Name="SkillConfirmText" TextWrapping="Wrap" FontWeight="SemiBold" />
          <WrapPanel>
            <Button x:Name="SkillConfirmButton" Content="Confirm cast" Click="SkillConfirmClick" />
            <Button Content="Cancel" Click="SkillCancelClick" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <TextBlock x:Name="SkillResultText" TextWrapping="Wrap" />
      <TextBlock Text="Active effects" Classes="h3" />
      <ListBox x:Name="EffectList" Classes="compact" Height="150" MaxWidth="520" HorizontalAlignment="Left">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="local:EffectRow">
            <TextBlock Text="{Binding Display}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Text="Right-click a skill or effect for more." Classes="muted" FontSize="11" />
      <TextBlock Text="Other" Classes="h3" />
      <WrapPanel>
        <TextBox x:Name="CharacterSkillId" Watermark="Skill name or ID" Width="190" />
        <Button Content="Cast skill" Click="CastCharacterSkillClick" />
        <Button Content="Rest (may use a turn)" Click="RestCharacterClick" />
      </WrapPanel>
      <WrapPanel>
        <TextBox x:Name="CharacterMoodEffect" Watermark="Effect to maintain" Width="165" />
        <Button Content="Apply mood" Click="ApplyCharacterMoodClick" />
      </WrapPanel>
    </StackPanel>
  </Border>
</UserControl>
