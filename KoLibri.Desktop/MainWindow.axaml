<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KoLibri.Desktop.MainWindow"
        Title="KoLibri — Arbitrage Console"
        Width="1200"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBrush}"
        AutomationProperties.Name="KoLibri Arbitrage Console">
  <Grid x:Name="ShellRoot"
        RowDefinitions="Auto,*"
        ColumnDefinitions="Auto,*,Auto"
        Background="{DynamicResource CanvasBrush}">
    <Border x:Name="Sidebar"
            Grid.Column="0"
            Grid.RowSpan="2"
            Width="260"
            Classes="shell-sidebar"
            BorderThickness="0,0,1,0"
            Padding="18,24">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="3">
          <TextBlock Text="KoLibri"
                     FontSize="24"
                     FontWeight="Bold"
                     Foreground="{DynamicResource InkBrush}" />
          <TextBlock Text="Shop-Arbitrage Console"
                     Classes="muted"
                     FontSize="12"
                     Margin="0,0,0,18" />
          <Border Classes="badge info" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="✣" Classes="badge-text info" AutomationProperties.Name="Theme" />
              <TextBlock x:Name="SidebarThemeLabel"
                         Text="Stickman Standard"
                         Classes="badge-text info" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="9" Margin="0,20,0,0">
          <Border Classes="badge warning" HorizontalAlignment="Stretch">
            <StackPanel Spacing="3">
              <TextBlock Text="Konten" Classes="badge-text warning" />
              <TextBlock Text="Main · Mallbot"
                         Classes="badge-text"
                         FontWeight="Normal" />
            </StackPanel>
          </Border>
          <Button x:Name="ThemeToggleButton"
                  Classes="secondary"
                  Content="☾  Ops Dark öffnen"
                  Click="ThemeToggleClick"
                  AutomationProperties.Name="Theme wechseln" />
          <TextBlock Text="v0.1 · lokale Vorschau"
                     FontSize="11"
                     Classes="muted" />
        </StackPanel>

        <StackPanel Spacing="2" Margin="0,22,0,0">
          <TextBlock Text="ARBEITSBEREICHE"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Classes="muted"
                     Margin="12,0,0,8" />
          <Button x:Name="NavOverview"
                  Classes="nav-item active"
                  Content="⌂   Übersicht"
                  Tag="Übersicht"
                  Click="OverviewClick"
                  AutomationProperties.Name="Übersicht öffnen" />
          <Button x:Name="NavPricing"
                  Classes="nav-item"
                  Content="◎   Pricing Engine"
                  Tag="Pricing Engine"
                  Click="PricingClick"
                  AutomationProperties.Name="Pricing Engine öffnen" />
          <Button x:Name="NavMall"
                  Classes="nav-item"
                  Content="▦   Mall &amp; Shop"
                  Tag="Mall &amp; Shop"
                  Click="MallClick"
                  AutomationProperties.Name="Mall und Shop öffnen" />
          <Button x:Name="NavAccounts"
                  Classes="nav-item"
                  Content="♙   Konten &amp; Transfer"
                  Tag="Konten &amp; Transfer"
                  Click="AccountsClick"
                  AutomationProperties.Name="Konten und Transfer öffnen" />
          <Button x:Name="NavAdventure"
                  Classes="nav-item"
                  Content="⚔   Adventure"
                  Tag="Adventure"
                  Click="AdventureClick"
                  AutomationProperties.Name="Adventure öffnen" />
          <Button x:Name="NavCombat"
                  Classes="nav-item"
                  Content="⚔   Combat"
                  Tag="Combat"
                  Click="CombatClick"
                  AutomationProperties.Name="Combat öffnen" />
          <Button x:Name="NavSettings"
                  Classes="nav-item"
                  Content="⚙   Einstellungen"
                  Tag="Einstellungen"
                  Click="SettingsClick"
                  AutomationProperties.Name="Einstellungen öffnen" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border x:Name="CompactNavigation"
            Grid.Column="1"
            Grid.Row="0"
            IsVisible="False"
            Classes="shell-header"
            BorderThickness="0,0,0,1"
            Padding="14,10">
      <ScrollViewer HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <TextBlock Text="KoLibri"
                     FontWeight="Bold"
                     FontSize="18"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource InkBrush}"
                     Margin="0,0,8,0" />
          <Button x:Name="CompactNavOverview"
                  Classes="nav-item active"
                  Content="⌂ Übersicht"
                  Tag="Übersicht"
                  Click="OverviewClick"
                  AutomationProperties.Name="Übersicht öffnen" />
          <Button x:Name="CompactNavPricing"
                  Classes="nav-item"
                  Content="◎ Pricing"
                  Tag="Pricing Engine"
                  Click="PricingClick"
                  AutomationProperties.Name="Pricing Engine öffnen" />
          <Button x:Name="CompactNavMall"
                  Classes="nav-item"
                  Content="▦ Mall"
                  Tag="Mall &amp; Shop"
                  Click="MallClick"
                  AutomationProperties.Name="Mall und Shop öffnen" />
          <Button x:Name="CompactNavAccounts"
                  Classes="nav-item"
                  Content="♙ Konten"
                  Tag="Konten &amp; Transfer"
                  Click="AccountsClick"
                  AutomationProperties.Name="Konten und Transfer öffnen" />
          <Button x:Name="CompactNavAdventure"
                  Classes="nav-item"
                  Content="⚔ Adventure"
                  Tag="Adventure"
                  Click="AdventureClick"
                  AutomationProperties.Name="Adventure öffnen" />
          <Button x:Name="CompactNavCombat"
                  Classes="nav-item"
                  Content="⚔ Combat"
                  Tag="Combat"
                  Click="CombatClick"
                  AutomationProperties.Name="Combat öffnen" />
          <Button x:Name="CompactNavSettings"
                  Classes="nav-item"
                  Content="⚙ Mehr"
                  Tag="Einstellungen"
                  Click="SettingsClick"
                  AutomationProperties.Name="Weitere Einstellungen öffnen" />
          <Button x:Name="CompactThemeToggleButton"
                  Classes="secondary"
                  Content="☾ Ops Dark"
                  Click="ThemeToggleClick"
                  AutomationProperties.Name="Theme wechseln" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <ScrollViewer Grid.Column="1"
                  Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="ContentRoot"
                  Margin="{DynamicResource ComfortableContentMargin}"
                  Spacing="24">
        <StackPanel x:Name="ShellHeader" Spacing="0">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
            <StackPanel>
              <TextBlock x:Name="ShellPageTitle" Text="Guten Morgen" Classes="h1" />
              <TextBlock x:Name="ShellPageDescription" Text="Dein Arbitrage-Überblick für heute."
                         Classes="muted"
                         FontSize="14"
                         Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
              <Border Classes="badge success">
                <TextBlock Text="● Read-only"
                           Classes="badge-text success"
                           AutomationProperties.Name="Read-only Modus" />
              </Border>
              <Border Classes="badge info">
                <TextBlock Text="⌁ Cache vor 4 Min."
                           Classes="badge-text info"
                           AutomationProperties.Name="Cache vor vier Minuten aktualisiert" />
              </Border>
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Konto" Classes="muted" FontSize="10" />
                <ComboBox x:Name="AccountRoleSelector"
                          Width="112"
                          SelectedIndex="1"
                          SelectionChanged="AccountRoleSelectionChanged"
                          AutomationProperties.Name="Aktives Konto auswählen">
                  <ComboBoxItem Content="Main" />
                  <ComboBoxItem Content="Mallbot" />
                </ComboBox>
              </StackPanel>
              <Button x:Name="GlobalRefreshButton"
                      Classes="primary"
                      Content="⟳  Daten aktualisieren"
                      Click="RefreshClick"
                      AutomationProperties.Name="Daten aktualisieren" />
            </StackPanel>
          </Grid>

        </StackPanel>

        <StackPanel x:Name="OverviewPanel" Spacing="24">

          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="Knucklebones heute" Classes="muted" />
                <TextBlock Text="42 / 100" Classes="kpi" Foreground="{DynamicResource AdventureBrush}" />
                <ProgressBar Value="42" Maximum="100" Height="7" />
                <TextBlock Text="Nächster Lauf: in 18 Min."
                           Classes="muted"
                           FontSize="12" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="Preisquellen-Cache" Classes="muted" />
                <TextBlock Text="96 % frisch" Classes="kpi" Foreground="{DynamicResource SuccessBrush}" />
                <TextBlock Text="Letzter Abgleich vor 4 Min."
                           Classes="muted"
                           FontSize="12" />
                <TextBlock Text="Pricegun · Mall · Shop"
                           Classes="muted"
                           FontSize="12" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="Kaufkandidaten" Classes="muted" />
                <TextBlock Text="7" Classes="kpi" Foreground="{DynamicResource MeatBrush}" />
                <TextBlock Text="über 20 % erwartete Marge"
                           Classes="muted"
                           FontSize="12" />
                <TextBlock Text="3 benötigen Detailpreis"
                           Classes="muted"
                           FontSize="12" />
              </StackPanel>
            </Border>
          </Grid>

          <Grid ColumnDefinitions="1.2*,*" ColumnSpacing="14">
            <Border Classes="card">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <StackPanel>
                    <TextBlock Text="Arbitrage-Pipeline" Classes="h2" />
                    <TextBlock Text="Priorisierte Aktionen aus dem letzten Scan"
                               Classes="muted"
                               FontSize="12" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Content="Alle anzeigen →"
                          Classes="secondary"
                          Foreground="{DynamicResource AccentBrush}"
                          Click="PricingClick"
                          AutomationProperties.Name="Alle Pricing-Aktionen anzeigen" />
                </Grid>
                <Grid ColumnDefinitions="2*,*,*,Auto"
                      RowDefinitions="Auto,Auto,Auto"
                      RowSpacing="12">
                  <TextBlock Text="Artikel" Classes="muted" FontSize="12" />
                  <TextBlock Grid.Column="1" Text="Einkauf" Classes="muted" FontSize="12" />
                  <TextBlock Grid.Column="2" Text="Zielpreis" Classes="muted" FontSize="12" />
                  <TextBlock Grid.Column="3" Text="Score" Classes="muted" FontSize="12" />
                  <TextBlock Grid.Row="1"
                             Text="Tiny Plastic Figure · Set A"
                             Classes="body" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="12 000 meat" Classes="body" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="18 500 meat" Foreground="{DynamicResource SuccessBrush}" />
                  <TextBlock Grid.Row="1" Grid.Column="3" Text="92" Foreground="{DynamicResource MeatBrush}" />
                  <TextBlock Grid.Row="2" Text="Pirate Encryption Key" Classes="body" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="8 400 meat" Classes="body" />
                  <TextBlock Grid.Row="2" Grid.Column="2" Text="11 200 meat" Foreground="{DynamicResource SuccessBrush}" />
                  <TextBlock Grid.Row="2" Grid.Column="3" Text="81" Foreground="{DynamicResource MeatBrush}" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Systemstatus" Classes="h2" />
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                  <TextBlock Text="Main-Account" Classes="body" />
                  <Border Grid.Column="1" Classes="badge warning">
                    <TextBlock Text="Simulation" Classes="badge-text warning" />
                  </Border>
                  <TextBlock Grid.Row="1" Text="Mallbot" Classes="body" />
                  <Border Grid.Row="1" Grid.Column="1" Classes="badge warning">
                    <TextBlock Text="Simulation" Classes="badge-text warning" />
                  </Border>
                  <TextBlock Grid.Row="2" Text="Letzte Aktion" Classes="muted" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="vor 4 Min." Classes="muted" />
                </Grid>
                <Border Classes="panel-subtle" Margin="0,5,0,0">
                  <TextBlock Text="Automatisches Kaufen bleibt bis zur Freigabe im Simulationsmodus."
                             TextWrapping="Wrap"
                             Classes="muted"
                             FontSize="12" />
                </Border>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>

        <Border x:Name="PageStatePanel" Classes="card" IsVisible="False">
          <StackPanel Spacing="10">
            <TextBlock x:Name="PageStateTitle" Text="Bereich" Classes="h2" />
            <TextBlock x:Name="PageStateDescription"
                       Classes="muted"
                       TextWrapping="Wrap" />
            <Border Classes="panel-subtle">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <TextBlock Text="Datenstatus" Classes="muted" />
                <TextBlock x:Name="PageStateStatus"
                           Grid.Column="1"
                           Classes="body"
                           Text="Noch keine Daten geladen."
                           TextWrapping="Wrap" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <Border x:Name="AccountsPanel" Classes="card" IsVisible="False">
          <StackPanel Spacing="14">
            <StackPanel Spacing="3">
              <TextBlock Text="Konten verbinden" Classes="h2" />
              <TextBlock Text="KoLibri meldet beide Rollen direkt bei KoL an. Benutzername und Session-Cookies werden verschlüsselt gespeichert; das Passwort ist optional verschlüsselt speicherbar."
                         Classes="muted"
                         TextWrapping="Wrap"
                         FontSize="12" />
            </StackPanel>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
              <Border Classes="panel-subtle">
                <StackPanel Spacing="8">
                  <TextBlock Text="Main" Classes="h2" FontSize="16" />
                  <TextBox x:Name="MainUsername" Watermark="Benutzername" AutomationProperties.Name="Main Benutzername" />
                  <TextBox x:Name="MainPassword" Watermark="Passwort" PasswordChar="●" AutomationProperties.Name="Main Passwort" />
                  <CheckBox x:Name="MainRememberPassword" Content="Passwort verschlüsselt speichern" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="MainAccountStatus"
                               Text="Noch nicht gespeichert"
                               Classes="muted"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="Login &amp; speichern"
                            Tag="Main"
                            Click="SaveAccountClick"
                            Classes="primary"
                            AutomationProperties.Name="Main anmelden und speichern" />
                  </Grid>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="panel-subtle">
                <StackPanel Spacing="8">
                  <TextBlock Text="Mallbot" Classes="h2" FontSize="16" />
                  <TextBox x:Name="MallbotUsername" Watermark="Benutzername" AutomationProperties.Name="Mallbot Benutzername" />
                  <TextBox x:Name="MallbotPassword" Watermark="Passwort" PasswordChar="●" AutomationProperties.Name="Mallbot Passwort" />
                  <CheckBox x:Name="MallbotRememberPassword" Content="Passwort verschlüsselt speichern" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="MallbotAccountStatus"
                               Text="Noch nicht gespeichert"
                               Classes="muted"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="Login &amp; speichern"
                            Tag="Mallbot"
                            Click="SaveAccountClick"
                            Classes="primary"
                            AutomationProperties.Name="Mallbot anmelden und speichern" />
                  </Grid>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </Border>

        <Border x:Name="MallPanel" Classes="card" IsVisible="False">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="3">
                <TextBlock Text="Mall &amp; eigener Shop" Classes="h2" />
                <TextBlock Text="Read-only-Übersicht mit Cache; es werden keine Listings verändert."
                           Classes="muted"
                           TextWrapping="Wrap"
                           FontSize="12" />
                <TextBlock x:Name="MallRoleLabel"
                           Text="Konto: Mallbot"
                           Classes="muted"
                           FontSize="12" />
              </StackPanel>
              <Button Grid.Column="1"
                      Content="⟳  Mall aktualisieren"
                      Click="RefreshMallClick"
                      Classes="primary"
                      AutomationProperties.Name="Mall aktualisieren" />
            </Grid>
            <TextBlock x:Name="MallSummary" Text="Noch keine Mall-Daten geladen." Classes="muted" />
            <TextBlock x:Name="MallRows" TextWrapping="Wrap" Classes="body" />
          </StackPanel>
        </Border>

        <Border x:Name="AdventurePanel" Classes="card" IsVisible="False">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="3">
                <TextBlock Text="Adventure &amp; Farm" Classes="h2" />
                <TextBlock Text="Frischer Status-/Inventar-Read und bounded Tagesplan; Ausführung bleibt separat freigabepflichtig."
                           Classes="muted" TextWrapping="Wrap" FontSize="12" />
              </StackPanel>
              <Button Grid.Column="1" Content="⟳  Plan aktualisieren"
                      Click="RefreshAdventureClick" Classes="primary"
                      AutomationProperties.Name="Adventure-Plan aktualisieren" />
            </Grid>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
              <Border Classes="panel-subtle">
                <StackPanel Spacing="4">
                  <TextBlock Text="Konto" Classes="muted" />
                  <TextBlock x:Name="AdventureAccountLabel" Text="Mallbot" Classes="body" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="panel-subtle">
                <StackPanel Spacing="4">
                  <TextBlock Text="Adventures" Classes="muted" />
                  <TextBlock x:Name="AdventureTurnsLabel" Text="—" Classes="body" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="panel-subtle">
                <StackPanel Spacing="4">
                  <TextBlock Text="Knucklebones" Classes="muted" />
                  <TextBlock x:Name="AdventureKnucklebonesLabel" Text="— / 100" Classes="body" />
                </StackPanel>
              </Border>
            </Grid>
            <Border Classes="panel-subtle">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Tagesplan" Classes="body" />
                  <Border Grid.Column="1" Classes="badge info">
                    <TextBlock Text="Preview only" Classes="badge-text info" />
                  </Border>
                </Grid>
                <TextBlock x:Name="AdventurePlanSummary" Text="Noch kein Snapshot geladen."
                           Classes="muted" TextWrapping="Wrap" />
                <TextBlock x:Name="AdventurePlanAdvisories" Classes="muted"
                           TextWrapping="Wrap" FontSize="12" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Border x:Name="CombatPanel" Classes="card" IsVisible="False">
          <StackPanel Spacing="14">
            <StackPanel Spacing="3">
              <TextBlock Text="Combat" Classes="h2" />
              <TextBlock Text="Manuelle und AutoCombat-Entscheidungen werden aus dem aktuellen Fight-Snapshot previewt."
                         Classes="muted" TextWrapping="Wrap" FontSize="12" />
            </StackPanel>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
              <Border Classes="panel-subtle">
                <StackPanel Spacing="4">
                  <TextBlock Text="Modus" Classes="muted" />
                  <TextBlock Text="Manual / AutoCombat" Classes="body" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="panel-subtle">
                <StackPanel Spacing="4">
                  <TextBlock Text="Policy" Classes="muted" />
                  <TextBlock Text="deterministisch · allowlisted" Classes="body" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="panel-subtle">
                <StackPanel Spacing="4">
                  <TextBlock Text="Mutation" Classes="muted" />
                  <TextBlock Text="Approval erforderlich" Classes="body" />
                </StackPanel>
              </Border>
            </Grid>
            <Border Classes="panel-subtle">
              <StackPanel Spacing="6">
                <TextBlock Text="Nächste Aktion" Classes="body" />
                <TextBlock x:Name="CombatPreviewSummary"
                           Text="Noch keine Combat-Observation geladen."
                           Classes="muted" TextWrapping="Wrap" />
                <TextBlock Text="CLI: combat manual · MCP: kol_autocombat_action_preview"
                           Classes="muted" FontSize="12" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Border x:Name="StatusBar" Classes="panel-subtle" IsVisible="False">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
            <Border Classes="badge info">
              <TextBlock Text="● Status" Classes="badge-text info" />
            </Border>
            <TextBlock x:Name="StatusText"
                       Grid.Column="1"
                       Classes="body"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
            <ProgressBar x:Name="BusyIndicator"
                         Grid.Column="2"
                         Width="100"
                         Height="6"
                         IsIndeterminate="True"
                         IsVisible="False"
                         AutomationProperties.Name="Aktualisierung läuft" />
            <Button x:Name="CancelRefreshButton"
                    Grid.Column="3"
                    Classes="secondary"
                    Content="Abbrechen"
                    IsVisible="False"
                    Click="CancelRefreshClick"
                    AutomationProperties.Name="Aktualisierung abbrechen" />
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border x:Name="ContextRail"
            Grid.Column="2"
            Grid.RowSpan="2"
            Width="300"
            IsVisible="False"
            Classes="shell-sidebar context-rail"
            BorderThickness="1,0,0,0"
            Padding="18,24">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="4">
          <TextBlock Text="KONTEXT" Classes="muted" FontSize="11" FontWeight="SemiBold" />
          <TextBlock x:Name="ContextRailTitle" Text="Übersicht" Classes="h2" FontSize="20" />
          <TextBlock x:Name="ContextRailKind" Text="Arbeitsbereich" Classes="muted" FontSize="12" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,20,0,0">
          <Button x:Name="ContextPreviewButton"
                  Content="Vorschau öffnen"
                  Classes="primary"
                  Click="ContextPreviewClick"
                  AutomationProperties.Name="Kontextvorschau öffnen" />
          <Button x:Name="ContextRefreshButton"
                  Content="Kontext aktualisieren"
                  Classes="secondary"
                  Click="ContextRefreshClick"
                  AutomationProperties.Name="Kontext aktualisieren" />
          <TextBlock Text="Mutierende Aktionen bleiben hinter Preview → Approval → Commit." Classes="muted" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
        <Border Classes="panel-subtle" Margin="0,22,0,0">
          <StackPanel Spacing="8">
            <TextBlock Text="Auswahl" Classes="body" />
            <TextBlock x:Name="ContextRailDetails"
                       Text="Wähle eine Mall-Zeile, ein Encounter oder eine Combat-Aktion aus, um Details und sichere Vorschauen zu sehen."
                       Classes="muted"
                       TextWrapping="Wrap"
                       FontSize="12" />
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>
  </Grid>
</Window>
