<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KoLibri.Desktop"
        xmlns:spiel="clr-namespace:KoLibri.Core.Spiel;assembly=KoLibri.Core"
        x:Class="KoLibri.Desktop.MainWindow"
        Title="KoLibri"
        Icon="/Assets/kolibri.ico"
        Width="1200"
        Height="760"
        MinWidth="820"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBrush}"
        KeyDown="WindowKeyDown"
        AutomationProperties.Name="KoLibri">
  <Grid x:Name="ShellRoot"
        RowDefinitions="Auto,*,Auto"
        ColumnDefinitions="Auto,*"
        Background="{DynamicResource CanvasBrush}">

    <!-- KoLmafia-style menu bar: the sections live in a row at the top,
         the way a KoL player expects them. -->
    <Border x:Name="MenuBar"
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Classes="shell-header"
            BorderThickness="0,0,0,1"
            Padding="14,8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="KoLibri"
                     FontSize="17"
                     FontWeight="Bold"
                     Foreground="{DynamicResource InkBrush}"
                     VerticalAlignment="Center"
                     Margin="0,0,12,0" />
          <Button x:Name="NavOverview"
                  Classes="menu-item"
                  Content="Guts"
                  Tag="Guts"
                  Click="SectionClick"
                  AutomationProperties.Name="Open guts" />
          <Button x:Name="NavInventory"
                  Classes="menu-item"
                  Content="Inventory"
                  Tag="Inventory"
                  Click="SectionClick"
                  AutomationProperties.Name="Open inventory" />
          <Button x:Name="NavDaily"
                  Classes="menu-item"
                  Content="Daily"
                  Tag="Daily"
                  Click="SectionClick"
                  AutomationProperties.Name="Open the daily routine" />
          <Button x:Name="NavArbitrage"
                  Classes="menu-item"
                  Content="Arbitrage"
                  Tag="Arbitrage"
                  Click="SectionClick"
                  AutomationProperties.Name="Open arbitrage" />
          <Button x:Name="NavMall"
                  Classes="menu-item"
                  Content="Mall"
                  Tag="Mall &amp; Shop"
                  Click="SectionClick"
                  AutomationProperties.Name="Open mall and shop" />
          <Button x:Name="NavAdventure"
                  Classes="menu-item"
                  Content="Adventures"
                  Tag="Adventure"
                  Click="SectionClick"
                  AutomationProperties.Name="Open adventures" />
          <Button x:Name="NavCombat"
                  Classes="menu-item"
                  Content="Combat"
                  Tag="Combat"
                  Click="SectionClick"
                  AutomationProperties.Name="Open combat" />
          <Button x:Name="NavBrowser"
                  Classes="menu-item"
                  Content="Browser"
                  Tag="Browser"
                  Click="SectionClick"
                  AutomationProperties.Name="Open the in-game browser" />
          <Button x:Name="NavAccounts"
                  Classes="menu-item"
                  Content="Accounts"
                  Tag="Accounts"
                  Click="SectionClick" />
          <Button x:Name="NavAgents"
                  Classes="menu-item"
                  Content="Agents"
                  Tag="Agents"
                  Click="SectionClick"
                  AutomationProperties.Name="Open AI agent access" />
        </WrapPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="Account" Classes="muted" FontSize="10" />
            <ComboBox x:Name="AccountRoleSelector"
                      Width="112"
                      SelectedIndex="1"
                      SelectionChanged="AccountRoleSelectionChanged"
                      AutomationProperties.Name="Select the active account">
              <ComboBoxItem Content="Main" />
              <ComboBoxItem Content="Mallbot" />
            </ComboBox>
          </StackPanel>
          <Button x:Name="GlobalRefreshButton"
                  Classes="secondary"
                  Content="Refresh"
                  Click="RefreshClick"
                  AutomationProperties.Name="Refresh current tab (F5)" />
          <Button x:Name="ThemeToggleButton"
                  Classes="secondary"
                  Content="☾"
                  Click="ThemeToggleClick"
                  AutomationProperties.Name="Toggle theme" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Character pane, like the KoL browser's left frame. -->
    <Border x:Name="CharacterPane" Grid.Row="1" Grid.Column="0" Width="210"
            Classes="shell-sidebar" BorderThickness="0,0,1,0">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12" Spacing="10">
          <StackPanel Spacing="2">
            <TextBlock x:Name="SidebarName" Text="Not signed in" FontSize="16" FontWeight="Bold"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="SidebarRole" Classes="muted" FontSize="11" />
          </StackPanel>
          <Separator />
          <StackPanel Spacing="4">
            <TextBlock Text="Vitals" Classes="muted" FontSize="10" />
            <TextBlock x:Name="SidebarLevel" Text="Level —" />
            <TextBlock x:Name="SidebarHp" Text="HP —" />
            <ProgressBar x:Name="SidebarHpBar" Height="6" Minimum="0" Maximum="1" Value="0" />
            <TextBlock x:Name="SidebarMp" Text="MP —" />
            <ProgressBar x:Name="SidebarMpBar" Height="6" Minimum="0" Maximum="1" Value="0" />
          </StackPanel>
          <Separator />
          <StackPanel Spacing="4">
            <TextBlock Text="Resources" Classes="muted" FontSize="10" />
            <TextBlock x:Name="SidebarAdventures" Text="Adventures —" />
            <TextBlock x:Name="SidebarMeat" Text="Meat —" />
          </StackPanel>
          <Separator />
          <StackPanel Spacing="4">
            <TextBlock Text="Organs" Classes="muted" FontSize="10" />
            <TextBlock x:Name="SidebarFullness" Text="Fullness —" />
            <TextBlock x:Name="SidebarDrunk" Text="Drunkenness —" />
            <TextBlock x:Name="SidebarSpleen" Text="Spleen —" />
          </StackPanel>
          <Separator />
          <StackPanel Spacing="4">
            <TextBlock Text="Familiar" Classes="muted" FontSize="10" />
            <TextBlock x:Name="SidebarFamiliar" Text="None" TextWrapping="Wrap" />
          </StackPanel>
          <Separator />
          <StackPanel Spacing="4">
            <TextBlock Text="Active effects" Classes="muted" FontSize="10" />
            <TextBlock x:Name="SidebarEffects" Text="None" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <ScrollViewer x:Name="PageScroll" Grid.Row="1" Grid.Column="1"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="ContentRoot"
                  MaxWidth="1100"
                  HorizontalAlignment="Center"
                  Margin="{DynamicResource ComfortableContentMargin}"
                  Spacing="12">
        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
          <TextBlock x:Name="ShellPageTitle" Text="Guts" Classes="h1" />
          <TextBlock x:Name="ShellPageDescription" Grid.Column="1" Classes="muted"
                     VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>

        <StackPanel x:Name="GutsPanel" Spacing="16" IsVisible="False">

          <Border Classes="card">
            <StackPanel Spacing="6">
              <TextBlock x:Name="GutsSummaryText"
                         Text="—"
                         Classes="muted"
                         FontSize="13" />
            </StackPanel>
          </Border>

          <ItemsControl x:Name="GutsAccountCards">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:GutsAccountCard">
                <Border Classes="card" Width="280" Margin="0,0,12,12">
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding PlayerName}" FontWeight="SemiBold" FontSize="15" />
                      <TextBlock Text="{Binding Role}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding MeatText}" IsVisible="{Binding HasStatus}" Classes="kpi" FontSize="20" />
                    <TextBlock Text="{Binding AdventuresText}" IsVisible="{Binding HasStatus}" Classes="muted" FontSize="12" />
                    <TextBlock Text="{Binding InventoryText}" IsVisible="{Binding HasStatus}" Classes="muted" FontSize="12" />
                    <TextBlock Text="{Binding FreshnessText}" TextWrapping="Wrap" Classes="muted" FontSize="11" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Classes="card">
            <Expander Header="KoL chat" x:Name="KoLChatPanel">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="ReadKoLChat" Content="Refresh chat" Click="ReadKoLChatClick" />
                  <ComboBox x:Name="KoLChatChannel" SelectionChanged="KoLChatChannelChanged"
                            AutomationProperties.Name="Chat channel" />
                </StackPanel>
                <TextBlock x:Name="KoLChatStatus" />
                <ScrollViewer MaxHeight="360">
                  <ItemsControl x:Name="KoLChatRows">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="spiel:KoLChatMessage">
                        <StackPanel Spacing="3" Margin="0,3">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Channel}" Classes="muted" />
                            <TextBlock Text="{Binding Sender}" FontWeight="SemiBold" />
                          </StackPanel>
                          <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="ReadKoLChatContacts" Content="Load contacts" Click="ReadKoLChatContactsClick" />
                  <ComboBox x:Name="KoLChatContacts" PlaceholderText="Choose a contact"
                            SelectionChanged="KoLChatContactChanged" AutomationProperties.Name="Chat contacts">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="spiel:KoLChatContact">
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <TextBox x:Name="KoLChatRecipient" Watermark="Player name or ID for a private message"
                         AutomationProperties.Name="Private chat recipient" />
                <TextBox x:Name="KoLChatDraft" Watermark="Message" AutomationProperties.Name="Chat message" />
                <Button x:Name="SendKoLChat" Content="Send chat message" Click="SendKoLChatClick" />
              </StackPanel>
            </Expander>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Text="Clan" Classes="h2" />
              <Button x:Name="ReadClanProfile" Content="Show clan membership" Click="ReadClanProfileClick" />
              <TextBlock x:Name="ClanProfileStatus" TextWrapping="Wrap" />
              <ItemsControl x:Name="ClanMembers">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="spiel:KoLClanMember">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Level, StringFormat='Level {0}'}" />
                      <TextBlock Text="{Binding Rank}" />
                      <TextBlock Text="{Binding Title}" Classes="muted" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Expander x:Name="ClanLounge" Header="Clan VIP lounge">
                <StackPanel Spacing="8">
                  <Button x:Name="ReadClanLounge" Content="Load lounge" Click="ReadClanLoungeClick" />
                  <TextBlock x:Name="ClanLoungeStatus" TextWrapping="Wrap" />
                  <ItemsControl x:Name="ClanLoungeFacilities">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="spiel:KoLClanLoungeFacility">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}" />
                          <TextBlock Text="{Binding FloorName}" Classes="muted" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button x:Name="UseClanLookingGlass" Content="Use Looking Glass" IsVisible="False" Click="UseClanLookingGlassClick" />
                  <Button x:Name="UseClanCrimboTree" Content="Check Crimbo Tree" IsVisible="False" Click="UseClanCrimboTreeClick" />
                  <Button x:Name="PlayClanKlaw" Content="Play Deluxe Mr. Klaw" IsVisible="False" Click="PlayClanKlawClick" />
                  <StackPanel x:Name="ClanFaxControls" IsVisible="False" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="ReceiveClanFax" Content="Receive fax" Click="ReceiveClanFaxClick" />
                    <Button x:Name="SendClanFax" Content="Send photocopy" Click="SendClanFaxClick" />
                    <Button x:Name="InspectClanFax" Content="Inspect photocopy" Click="InspectClanFaxClick" />
                  </StackPanel>
                  <StackPanel x:Name="ClanSwimControls" IsVisible="False" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="SwimClanLaps" Content="Swim laps" Click="SwimClanLapsClick" />
                    <Button x:Name="SwimClanSprints" Content="Submarine sprints" Click="SwimClanSprintsClick" />
                    <Button x:Name="ClanCannonball" Content="Cannonball" Click="ClanCannonballClick" />
                    <Button x:Name="CheckClanPoolChoice" Content="Check pool state" Click="CheckClanPoolChoiceClick" />
                  </StackPanel>
                  <WrapPanel x:Name="ClanPoolChoiceControls" IsVisible="False">
                    <Button x:Name="ClanPoolHandstand" Content="Handstand" Click="ClanPoolHandstandClick" />
                    <Button x:Name="ClanPoolDive" Content="Dive for treasure" Click="ClanPoolDiveClick" />
                    <Button x:Name="ClanPoolBlink" Content="Close eyes" Click="ClanPoolBlinkClick" />
                    <Button x:Name="LeaveClanPool" Content="Leave pool" Click="LeaveClanPoolClick" />
                  </WrapPanel>
                  <StackPanel x:Name="ClanShowerControls" IsVisible="False" Spacing="4">
                    <ComboBox x:Name="ClanShowerTemperature" PlaceholderText="Choose shower temperature" AutomationProperties.Name="Shower temperature">
                      <ComboBoxItem Content="Cold" />
                      <ComboBoxItem Content="Cool" />
                      <ComboBoxItem Content="Lukewarm" />
                      <ComboBoxItem Content="Warm" />
                      <ComboBoxItem Content="Hot" />
                    </ComboBox>
                    <Button x:Name="TakeClanShower" Content="Take April Shower" Click="TakeClanShowerClick" />
                  </StackPanel>
                  <StackPanel x:Name="ClanPoolControls" IsVisible="False" Spacing="4">
                    <ComboBox x:Name="ClanPoolStance" PlaceholderText="Choose pool stance" AutomationProperties.Name="Pool stance">
                      <ComboBoxItem Content="Aggressive" />
                      <ComboBoxItem Content="Strategic" />
                      <ComboBoxItem Content="Stylish" />
                    </ComboBox>
                    <Button x:Name="PlayClanPool" Content="Play pool" Click="PlayClanPoolClick" />
                  </StackPanel>
                  <StackPanel x:Name="ClanHotTubControls" IsVisible="False" Spacing="4">
                    <CheckBox x:Name="AllowHotTubCurseRemoval" Content="Allow removing Cursed effects" />
                    <Button x:Name="UseClanHotTub" Content="Use Hot Tub" Click="UseClanHotTubClick" />
                  </StackPanel>
                </StackPanel>
              </Expander>
              <Expander x:Name="ClanStash" Header="Clan stash">
                <StackPanel Spacing="8">
                  <Button x:Name="ReadClanStash" Content="Load stash" Click="ReadClanStashClick" />
                  <TextBlock x:Name="ClanStashStatus" TextWrapping="Wrap" />
                  <ListBox x:Name="ClanStashItems">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="spiel:KoLClanStashItem">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}" />
                          <TextBlock Text="{Binding Quantity}" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBox x:Name="ClanStashQuantity" Watermark="Quantity" AutomationProperties.Name="Quantity to take" />
                  <Button x:Name="TakeClanStash" Content="Take selected item" Click="TakeClanStashClick" />
                  <Button x:Name="LoadClanStashDepositItems" Content="Load inventory for deposit" Click="LoadClanStashDepositItemsClick" />
                  <ComboBox x:Name="ClanStashDepositItems" PlaceholderText="Choose an inventory item">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="local:DesktopInventoryItem">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}" />
                          <TextBlock Text="{Binding Quantity}" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBox x:Name="ClanStashDepositQuantity" Watermark="Quantity" AutomationProperties.Name="Quantity to deposit" />
                  <Button x:Name="DepositClanStash" Content="Deposit selected item" Click="DepositClanStashClick" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Text="KoLmail" Classes="h2" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="KoLmailRead" Content="Inbox" Click="ReadKoLmailInboxClick" />
                <Button x:Name="KoLmailSaved" Content="Saved mail" Click="ReadKoLmailSavedClick" />
                <Button x:Name="KoLmailOutbox" Content="Sent mail" Click="ReadKoLmailOutboxClick" />
                <Button x:Name="KoLmailPrevious" Content="Previous page" IsEnabled="False" Click="PreviousKoLmailPageClick" />
                <Button x:Name="KoLmailNext" Content="Next page" IsEnabled="False" Click="NextKoLmailPageClick" />
              </StackPanel>
              <TextBlock x:Name="KoLmailInboxStatus" TextWrapping="Wrap" />
              <ListBox x:Name="KoLmailInboxRows" SelectionChanged="KoLmailSelectionChanged">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="spiel:KoLMailEntry">
                    <StackPanel Margin="0,4" Spacing="3">
                      <TextBlock Text="{Binding Correspondent}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Date}" Classes="muted" />
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding AttachedMeatLabel}" IsVisible="{Binding HasAttachedMeat}" FontWeight="SemiBold" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <WrapPanel>
                <Button x:Name="KoLmailSave" Content="Save selected message" Click="SaveKoLmailClick" />
                <Button x:Name="KoLmailDelete" Content="Delete selected message" Click="DeleteKoLmailClick" />
                <Button x:Name="KoLmailConfirmDelete" Content="Confirm deletion" IsVisible="False" Click="ConfirmDeleteKoLmailClick" />
              </WrapPanel>
              <Expander x:Name="KoLmailComposer" Header="Compose KoLmail">
                <StackPanel Spacing="8">
                  <TextBox x:Name="KoLmailRecipient" Watermark="Player name or ID" AutomationProperties.Name="Recipient" />
                  <TextBox x:Name="KoLmailMessage" Watermark="Message" AutomationProperties.Name="Message"
                           AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />
                  <TextBox x:Name="KoLmailAttachments" Watermark="Attachments (item ID and quantity, one pair per line)"
                           AutomationProperties.Name="Attachments" AcceptsReturn="True" />
                  <TextBox x:Name="KoLmailMeat" Watermark="Meat (optional)" AutomationProperties.Name="Meat to send" />
                  <Button x:Name="KoLmailSend" Content="Send KoLmail" Click="SendKoLmailClick" />
                  <TextBlock x:Name="KoLmailSendStatus" TextWrapping="Wrap" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>

          <Border Classes="card" Padding="0">
            <Grid RowDefinitions="Auto,*">
              <StackPanel Grid.Row="0" Margin="14,12,14,8">
                <TextBlock Text="Own store" Classes="muted" FontSize="11" FontWeight="SemiBold" />
                <TextBlock x:Name="StoreSummaryText" Text="—" Classes="muted" FontSize="12" />
              </StackPanel>
              <ListBox MaxHeight="380" x:Name="StoreRows"
                       Grid.Row="1"
                       AutomationProperties.Name="Own store listings">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:LiveShopRow">
                    <Grid ColumnDefinitions="2*,Auto,Auto" ColumnSpacing="12" Margin="0,3">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding ItemName}" />
                        <TextBlock Text="{Binding ItemId}" Classes="muted" FontSize="11" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding PriceText}" />
                      <TextBlock Grid.Column="2" Text="{Binding QuantityText}" Classes="muted" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

        </StackPanel>

        <StackPanel x:Name="ArbitragePanel" Spacing="16" IsVisible="False">

          <Border Classes="card">
            <StackPanel Spacing="6">
              <TextBlock x:Name="ArbitrageSummaryText"
                         Text="—"
                         Classes="muted"
                         FontSize="13" />
              <TextBlock Text="Live mall listings against the pricegun median. Buying stays behind the approval token."
                         Classes="muted"
                         FontSize="12"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Classes="card" Padding="0">
            <Grid RowDefinitions="Auto,*">
              <Grid Grid.Row="0"
                    ColumnDefinitions="*,115,145,90"
                    ColumnSpacing="12" Margin="14,12,14,8">
                <TextBlock Grid.Column="0" Text="Item" Classes="muted" FontSize="11" />
                <TextBlock Grid.Column="1" Text="Cheapest" Classes="muted" FontSize="11" />
                <TextBlock Grid.Column="2" Text="Spread" Classes="muted" FontSize="11" />
                <TextBlock Grid.Column="3" Text="Margin" Classes="muted" FontSize="11" />
              </Grid>
              <ListBox x:Name="ArbitrageRows"
                       Grid.Row="1"
                       AutomationProperties.Name="Arbitrage candidates">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:LiveArbitrageRow">
                    <Grid ColumnDefinitions="*,115,145,90" ColumnSpacing="12" Margin="0,3">
                      <TextBlock Grid.Column="0" Text="{Binding ItemName}" />
                      <TextBlock Grid.Column="1" Text="{Binding CheapestPrice}" />
                      <TextBlock Grid.Column="2" Text="{Binding SpreadText}" />
                      <TextBlock Grid.Column="3" Text="{Binding MarginText}" Classes="muted" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Border Classes="card" Padding="0">
            <Grid RowDefinitions="Auto,Auto,*">
              <Grid Grid.Row="0"
                    ColumnDefinitions="*,115,126,75,140"
                    ColumnSpacing="12" Margin="14,12,14,8">
                <TextBlock Grid.Column="0" Text="Buy rule" Classes="muted" FontSize="11" />
                <TextBlock Grid.Column="1" Text="Price ceiling" Classes="muted" FontSize="11" />
                <TextBlock Grid.Column="2" Text="Resale reference" Classes="muted" FontSize="11" />
                <TextBlock Grid.Column="3" Text="Listings" Classes="muted" FontSize="11" />
                <TextBlock Grid.Column="4" Text="Projected profit" Classes="muted" FontSize="11" />
              </Grid>
              <TextBlock Grid.Row="1"
                         x:Name="ArbitragePlanText"
                         Text="—"
                         Classes="muted"
                         FontSize="12"
                         Margin="14,0,14,8" />
              <ListBox x:Name="ArbitrageRules"
                       Grid.Row="2"
                       AutomationProperties.Name="Buy rules">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:BuyRuleRow">
                    <Grid ColumnDefinitions="*,115,126,75,140" ColumnSpacing="12" Margin="0,3">
                      <TextBlock Grid.Column="0" Text="{Binding ItemName}" />
                      <TextBlock Grid.Column="1" Text="{Binding CeilingText}" />
                      <TextBlock Grid.Column="2" Text="{Binding ResalePrice}" />
                      <TextBlock Grid.Column="3" Text="{Binding CandidateCount}" />
                      <TextBlock Grid.Column="4" Text="{Binding ProfitText}" Classes="muted" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

        </StackPanel>

        <StackPanel x:Name="DailyPanel" Spacing="16" IsVisible="False">

          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Text="Daily briefing" Classes="h2" />
              <TextBlock x:Name="DailySnapshotText"
                         Text="—"
                         Classes="muted"
                         FontSize="13" />
              <TextBlock x:Name="DailySummaryText"
                         Text="—"
                         Classes="muted"
                         FontSize="12" />
            </StackPanel>
          </Border>

          <Border Classes="card" Padding="0">
            <Grid RowDefinitions="Auto,*">
              <Grid Grid.Row="0"
                    ColumnDefinitions="140,2*,3*,110"
                    ColumnSpacing="12" Margin="14,12,14,8">
                <TextBlock Grid.Column="0" Text="Area" Classes="muted" FontSize="11" />
                <TextBlock Grid.Column="1" Text="Action" Classes="muted" FontSize="11" />
                <TextBlock Grid.Column="2" Text="Details" Classes="muted" FontSize="11" />
                <TextBlock Grid.Column="3" Text="Status" Classes="muted" FontSize="11" />
              </Grid>
              <ListBox x:Name="DailyRows"
                       Grid.Row="1"
                       SelectionChanged="DailySelectionChanged"
                       AutomationProperties.Name="Farm plan">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:DailyBriefingRow">
                    <Grid ColumnDefinitions="140,2*,3*,110" ColumnSpacing="10" Margin="0,3">
                      <TextBlock Grid.Column="0" Text="{Binding Surface}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="{Binding Description}" />
                      <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="muted" />
                      <TextBlock Grid.Column="3" Text="{Binding State}" Classes="muted" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="DailyRunButton"
                        Classes="primary"
                        Content="▶  Run the daily routine"
                        Click="DailyRunClick"
                        AutomationProperties.Name="Run the daily routine" />
              </StackPanel>
              <WrapPanel>
                <TextBlock Text="Hermit clovers to trade for" VerticalAlignment="Center" Margin="0,0,8,0" />
                <NumericUpDown x:Name="DailyHermitClovers" Value="0" Minimum="0" Maximum="20"
                               Width="92" AutomationProperties.Name="Hermit clovers to trade for" />
                <CheckBox x:Name="DailyBaconTopUp" Content="Top up BACON from the mall (max meat per BACON:)"
                          IsChecked="False" Margin="16,0,8,0" />
                <NumericUpDown x:Name="DailyBaconMaxPrice" Value="1500" Minimum="1" Maximum="100000"
                               Width="110" AutomationProperties.Name="Maximum meat per BACON" />
              </WrapPanel>
              <TextBlock x:Name="DailyStatusText"
                         Text="Nothing executed yet."
                         Classes="muted"
                         FontSize="12"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

        </StackPanel>

        <StackPanel x:Name="InventoryPanel" Spacing="16" IsVisible="False">
          <Border Classes="card">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Spacing="8">
                <TextBlock x:Name="InventorySummaryText"
                           Text="No entries."
                           Classes="muted"
                           FontSize="13" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                <TextBox x:Name="InventorySearchBox"
                         Width="240"
                         Watermark="Filter by name or ID"
                         TextChanged="InventorySearchChanged"
                         AutomationProperties.Name="Filter inventory" />
                <TextBlock x:Name="InventoryLoadedText"
                           Text="—"
                           Classes="muted"
                           FontSize="11"
                           HorizontalAlignment="Right" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Classes="card" Padding="8,6">
            <StackPanel x:Name="InventoryCategoryStrip" Orientation="Horizontal" Spacing="4" />
          </Border>

          <Grid ColumnDefinitions="2*,3*" ColumnSpacing="14" Height="450">

            <Border Classes="card" Padding="0">
              <Grid RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0"
                           Text="Items"
                           Classes="muted"
                           Margin="14,12,14,8" />
                <ListBox x:Name="InventoryList"
                         Grid.Row="1"
                         SelectionChanged="InventorySelectionChanged"
                         AutomationProperties.Name="Inventory items">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:DesktopInventoryItem">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}"
                                     VerticalAlignment="Center" />
                          <TextBlock Text="{Binding ItemId}"
                                     Classes="muted"
                                     FontSize="11"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Quantity}"
                                   Classes="muted"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>

            <Border Grid.Column="1" Classes="card">
              <StackPanel Spacing="12">
                <StackPanel x:Name="InventoryDetailPanel" Spacing="10">
                  <TextBlock Text="No item selected" Classes="muted" />
                </StackPanel>
                <TextBlock Text="Equipment and familiar" Classes="h3" />
                <TextBlock x:Name="CharacterEquipmentStatus" TextWrapping="Wrap" />
                <WrapPanel>
                  <Button Content="Read equipment" Click="ReadCharacterEquipmentClick" />
                  <ComboBox x:Name="CharacterSlotPicker" Width="135"
                            AutomationProperties.Name="Equipment slot" />
                  <Button Content="Unequip slot" Click="UnequipCharacterSlotClick" />
                </WrapPanel>
                <WrapPanel>
                  <TextBox x:Name="CharacterOutfitId" Watermark="Outfit ID" Width="105" />
                  <Button Content="Wear outfit" Click="WearCharacterOutfitClick" />
                </WrapPanel>
                <WrapPanel>
                  <TextBox x:Name="CharacterFamiliarId" Watermark="Familiar ID" Width="105" />
                  <Button Content="Switch familiar" Click="SwitchCharacterFamiliarClick" />
                  <Button Content="Unequip familiar" Click="UnequipCharacterFamiliarClick" />
                </WrapPanel>
                <TextBlock Text="Resources and effects" Classes="h3" />
                <TextBlock x:Name="CharacterResourceStatus" TextWrapping="Wrap" />
                <WrapPanel>
                  <TextBox x:Name="CharacterSkillId" Watermark="Skill ID" Width="105" />
                  <Button Content="Cast skill" Click="CastCharacterSkillClick" />
                  <Button Content="Rest (may use a turn)" Click="RestCharacterClick" />
                </WrapPanel>
                <WrapPanel>
                  <TextBox x:Name="CharacterMoodEffect" Watermark="Effect to maintain" Width="165" />
                  <Button Content="Apply mood" Click="ApplyCharacterMoodClick" />
                </WrapPanel>
                <WrapPanel>
                  <TextBox x:Name="CharacterModifierGoal" Watermark="Modifier, e.g. Item Drop" Width="170" />
                  <Button Content="Compare selected slot" Click="CompareCharacterEquipmentClick" />
                </WrapPanel>
                <TextBlock x:Name="CharacterGearPreview" TextWrapping="Wrap" />
                <TextBlock Text="Closet and storage" Classes="h3" />
                <TextBlock x:Name="CharacterStorageStatus" TextWrapping="Wrap" />
                <Button Content="Read closet and storage" Click="ReadCharacterStorageClick" />
                <ComboBox x:Name="CharacterStoredItem" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Stored item">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="local:CharacterStoredItemRow">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Take one" Click="TakeCharacterStoredItemClick" />
                <TextBlock Text="Acquire an item" Classes="h3" />
                <TextBox x:Name="CharacterAcquireItem" Watermark="Exact item name" />
                <WrapPanel>
                  <Button Content="Find sources" Click="PreviewCharacterAcquisitionClick" />
                  <Button x:Name="CharacterCombineButton" Content="Combine" IsEnabled="False"
                          Click="CombineCharacterItemClick" />
                </WrapPanel>
                <TextBlock x:Name="CharacterAcquisitionStatus" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

          </Grid>

        </StackPanel>

        <Border x:Name="BrowserPanel" Classes="card" IsVisible="False">
          <StackPanel Spacing="8" MaxWidth="560" HorizontalAlignment="Center" Margin="0,24">
            <TextBlock Text="In-game browser" Classes="h2" HorizontalAlignment="Center" />
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Classes="muted"
                       Text="Playing in the normal KoL web pages inside KoLibri is planned but not available yet. No embedded web view works on Windows, Linux and macOS without large native packages, so this page is a placeholder. Use the Adventures page for manual play meanwhile. See docs/desktop-browser.md for the options." />
          </StackPanel>
        </Border>

        <Border x:Name="AgentsPanel" Classes="card" IsVisible="False">
          <StackPanel Spacing="12">
            <TextBlock Text="AI agent access" Classes="h2" />
            <TextBlock Text="Clients that connected through kolibri-mcp and what you approved for them. Revoking cuts a client off immediately. Limits count per KoL day."
                       Classes="muted" TextWrapping="Wrap" FontSize="12" />
            <StackPanel x:Name="AgentsList" Spacing="10" />
          </StackPanel>
        </Border>

        <Border x:Name="AccountsPanel" Classes="card" IsVisible="False">
          <StackPanel Spacing="14">
            <StackPanel Spacing="3">
              <TextBlock Text="Connect accounts" Classes="h2" />
              <TextBlock Text="KoLibri logs both roles in at KoL directly. User name and session cookies are stored encrypted; the password can be stored encrypted as well."
                         Classes="muted"
                         TextWrapping="Wrap"
                         FontSize="12" />
            </StackPanel>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
              <Border Classes="panel-subtle">
                <StackPanel Spacing="8">
                  <TextBlock Text="Main" Classes="h2" FontSize="16" />
                  <TextBox x:Name="MainUsername" Watermark="Username" AutomationProperties.Name="Main Username" />
                  <TextBox x:Name="MainPassword" Watermark="Password" PasswordChar="●" AutomationProperties.Name="Main Password" />
                  <CheckBox x:Name="MainRememberPassword" Content="Remember password for reconnecting" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="MainAccountStatus"
                               Text="Signed out"
                               Classes="muted"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="Sign in"
                            Tag="Main"
                            Click="SaveAccountClick"
                            Classes="primary"
                            AutomationProperties.Name="Main sign in" />
                  </Grid>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="panel-subtle">
                <StackPanel Spacing="8">
                  <TextBlock Text="Mallbot" Classes="h2" FontSize="16" />
                  <TextBox x:Name="MallbotUsername" Watermark="Username" AutomationProperties.Name="Mallbot Username" />
                  <TextBox x:Name="MallbotPassword" Watermark="Password" PasswordChar="●" AutomationProperties.Name="Mallbot Password" />
                  <CheckBox x:Name="MallbotRememberPassword" Content="Remember password for reconnecting" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="MallbotAccountStatus"
                               Text="Signed out"
                               Classes="muted"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="Sign in"
                            Tag="Mallbot"
                            Click="SaveAccountClick"
                            Classes="primary"
                            AutomationProperties.Name="Mallbot sign in" />
                  </Grid>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </Border>

        <StackPanel x:Name="MallSection" Spacing="16" IsVisible="False">
          <local:MallSearchView x:Name="MallSearch" />
        </StackPanel>

        <Border x:Name="AdventurePanel" Classes="card" IsVisible="False">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="3">
                <TextBlock Text="Adventure &amp; Farm" Classes="h2" />
                <TextBlock Text="Fresh status and inventory read plus the bounded daily plan; execution stays separately gated."
                           Classes="muted" TextWrapping="Wrap" FontSize="12" />
              </StackPanel>
              <Button Grid.Column="1" Content="⟳  Refresh plan"
                      Click="RefreshClick" Classes="primary"
                      AutomationProperties.Name="Adventure-Refresh plan" />
            </Grid>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
              <Border Classes="panel-subtle">
                <StackPanel Spacing="4">
                  <TextBlock Text="Account" Classes="muted" />
                  <TextBlock x:Name="AdventureAccountLabel" Text="Mallbot" Classes="body" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="panel-subtle">
                <StackPanel Spacing="4">
                  <TextBlock Text="Adventures" Classes="muted" />
                  <TextBlock x:Name="AdventureTurnsLabel" Text="—" Classes="body" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="panel-subtle">
                <StackPanel Spacing="4">
                  <TextBlock Text="Knucklebones" Classes="muted" />
                  <TextBlock x:Name="AdventureKnucklebonesLabel" Text="— / 100" Classes="body" />
                </StackPanel>
              </Border>
            </Grid>
            <Border Classes="panel-subtle">
              <StackPanel Spacing="6">
                <TextBlock Text="Deep Fat Friars" Classes="h3" />
                <TextBlock x:Name="FriarsPageStatus" TextWrapping="Wrap" />
                <WrapPanel>
                  <Button Content="Open Friars" Click="OpenFriarsClick" />
                  <Button x:Name="FriarRitualButton" Content="Perform ritual" Click="FriarRitualClick" IsEnabled="False" />
                  <Button x:Name="FriarFoodButton" Content="Food blessing" Click="FriarBlessingClick" Tag="Food" IsEnabled="False" />
                  <Button x:Name="FriarFamiliarButton" Content="Familiar blessing" Click="FriarBlessingClick" Tag="Familiar" IsEnabled="False" />
                  <Button x:Name="FriarBoozeButton" Content="Booze blessing" Click="FriarBlessingClick" Tag="Booze" IsEnabled="False" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Classes="panel-subtle">
              <StackPanel Spacing="6">
                <TextBlock Text="Manual adventures" Classes="h3" />
                <TextBlock Text="Choose a location to start a manual adventure or a bounded run."
                           Classes="muted" TextWrapping="Wrap" FontSize="12" />
                <Grid>
                  <StackPanel Spacing="6">
                    <TextBlock Text="Location" Classes="muted" />
                    <TextBox x:Name="EncounterFilterBox" Watermark="Filter by location or zone" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button x:Name="EncounterStartButton" Content="Start" Classes="primary" />
                      <Button x:Name="EncounterSubmitButton" Content="Submit action" Classes="secondary" />
                      <Button x:Name="EncounterRecheckButton" Content="Recheck encounter" Classes="secondary" />
                      <Button x:Name="EncounterEndButton" Content="End run" Classes="secondary" />
                    </StackPanel>
                    <WrapPanel>
                      <NumericUpDown x:Name="EncounterBatchTurns" Value="10" Minimum="1" Maximum="100"
                                     Width="92" AutomationProperties.Name="Adventure turn budget" />
                      <TextBox x:Name="EncounterBatchItem" Watermark="Stop when owned (item ID)" Width="190" />
                      <Button x:Name="EncounterBatchStart" Content="Run turns" />
                      <Button x:Name="EncounterBatchContinue" Content="Continue remaining turns" />
                    </WrapPanel>
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Height="270">
                  <DockPanel>
                    <TextBlock Text="Locations" Classes="muted" DockPanel.Dock="Top" />
                    <ListBox x:Name="EncounterLocationsGrid">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:EncounterBrowserLocationRow">
                          <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </DockPanel>
                  <DockPanel Grid.Column="1">
                    <TextBlock Text="Monsters" Classes="muted" DockPanel.Dock="Top" />
                    <ListBox x:Name="EncounterMonstersGrid">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:EncounterBrowserMonsterRow">
                          <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </DockPanel>
                  <DockPanel Grid.Column="2">
                    <TextBlock Text="Actions" Classes="muted" DockPanel.Dock="Top" />
                    <ListBox x:Name="EncounterActionsGrid">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:EncounterBrowserActionRow">
                          <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </DockPanel>
                </Grid>
                <Border Classes="panel-subtle" Padding="10">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Status / Step-Log" Classes="muted" />
                    <TextBlock x:Name="EncounterStatusText" Text="(no adventure session yet)" Classes="body" TextWrapping="Wrap" />
                    <TextBlock x:Name="EncounterStepLogText" Classes="body" TextWrapping="Wrap" FontFamily="monospace" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <Border Classes="panel-subtle">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Farm plan" Classes="body" />
                  <Border Grid.Column="1" Classes="badge info">
                    <TextBlock Text="Preview only" Classes="badge-text info" />
                  </Border>
                </Grid>
                <TextBlock x:Name="AdventurePlanSummary" Text="Waiting for account data."
                           Classes="muted" TextWrapping="Wrap" />
                <TextBlock x:Name="AdventurePlanAdvisories" Classes="muted"
                           TextWrapping="Wrap" FontSize="12" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <StackPanel x:Name="CombatSection" Spacing="16" IsVisible="False">

          <Border Classes="card">
            <StackPanel Spacing="6">
              <TextBlock Text="Auto-combat" Classes="h2" />
              <TextBlock Text="Pick a target, the skills and items the engine may use, and when to give up. One panel instead of a dozen clicks."
                         Classes="muted"
                         FontSize="12"
                         TextWrapping="Wrap" />
              <TextBlock Text="The preview is an estimate: the effect and modifier tracker does not follow every conditional buff yet."
                         Classes="muted"
                         FontSize="11"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="2*,2*,2*" ColumnSpacing="12">

            <Border Classes="card" Padding="0">
              <Grid RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="Target" Classes="muted" Margin="12,10,12,6" />
                <ListBox x:Name="CombatTargetList"
                         Grid.Row="1"
                         SelectionChanged="CombatTargetChanged"
                         AutomationProperties.Name="Combat target">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:CombatTarget">
                      <StackPanel Margin="0,2">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>

            <Border Grid.Column="1" Classes="card" Padding="0">
              <Grid RowDefinitions="Auto,Auto,*">
                <TextBlock Grid.Row="0" Text="Skills" Classes="muted" Margin="12,10,12,6" />
                <ComboBox Grid.Row="1"
                          x:Name="CombatSkillPicker"
                          Width="220"
                          HorizontalAlignment="Left"
                          Margin="12,0,12,6"
                          SelectionChanged="CombatSkillPicked"
                          AutomationProperties.Name="Pick a skill" />
                <ListBox Grid.Row="2" x:Name="CombatSkillList">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:CombatOption">
                      <TextBlock Text="{Binding Name}" Margin="0,2" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>

            <Border Grid.Column="2" Classes="card" Padding="0">
              <Grid RowDefinitions="Auto,Auto,*">
                <TextBlock Grid.Row="0" Text="Items" Classes="muted" Margin="12,10,12,6" />
                <ComboBox Grid.Row="1"
                          x:Name="CombatItemPicker"
                          Width="220"
                          HorizontalAlignment="Left"
                          Margin="12,0,12,6"
                          SelectionChanged="CombatItemPicked"
                          AutomationProperties.Name="Pick an item" />
                <ListBox Grid.Row="2" x:Name="CombatItemList">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:CombatOption">
                      <TextBlock Text="{Binding Name}" Margin="0,2" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>

          </Grid>

          <Border Classes="card">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="18">
                <StackPanel Spacing="4">
                  <TextBlock Text="Abort below" Classes="muted" FontSize="11" />
                  <NumericUpDown x:Name="CombatAbortHp"
                                 Width="120"
                                 Minimum="0"
                                 Maximum="100"
                                 Increment="5"
                                 ValueChanged="CombatAbortChanged"
                                 AutomationProperties.Name="Abort below this hit point percentage" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="Max rounds" Classes="muted" FontSize="11" />
                  <NumericUpDown x:Name="CombatMaxRounds"
                                 Width="120"
                                 Minimum="1"
                                 Maximum="200"
                                 Increment="5"
                                 ValueChanged="CombatRoundsChanged"
                                 AutomationProperties.Name="Maximum number of rounds" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                  <TextBlock Text="Uses the open adventure on the selected account." Classes="muted" FontSize="11" />
                </StackPanel>
              </Grid>
              <Border Classes="panel-subtle" Padding="10">
                <TextBlock x:Name="CombatPreviewText"
                           Text="Pick a target and at least one skill to see the plan."
                           Classes="body"
                           TextWrapping="Wrap" />
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="CombatRunButton"
                        Classes="primary"
                        Content="▶  Fight current encounter"
                        Click="CombatRunClick"
                        AutomationProperties.Name="Fight the current encounter on the selected account" />
                <TextBlock x:Name="CombatRunStatusText"
                           Text="No fight has run yet."
                           Classes="muted"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>

        </StackPanel>

    </StackPanel>
    </ScrollViewer>

    <Border x:Name="StatusBar"
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Classes="shell-header"
            BorderThickness="0,1,0,0"
            Padding="14,6">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
        <TextBlock x:Name="StatusText"
                   Grid.Column="0"
                   Classes="body"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap" />
        <ProgressBar x:Name="BusyIndicator"
                     Grid.Column="1"
                     Width="100"
                     Height="6"
                     HorizontalAlignment="Left"
                     IsIndeterminate="True"
                     IsVisible="False"
                     AutomationProperties.Name="Refreshing" />
        <Button x:Name="CancelRefreshButton"
                Grid.Column="2"
                Classes="secondary"
                Content="Cancel"
                IsVisible="False"
                Click="CancelRefreshClick"
                AutomationProperties.Name="Cancel current operation" />
      </Grid>
    </Border>

  </Grid>
</Window>
