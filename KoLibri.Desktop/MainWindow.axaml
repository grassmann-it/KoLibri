<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KoLibri.Desktop"
        x:Class="KoLibri.Desktop.MainWindow"
        Title="KoLibri — Arbitrage Console"
        Width="1200"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBrush}"
        KeyDown="WindowKeyDown"
        AutomationProperties.Name="KoLibri Arbitrage Console">
  <Grid x:Name="ShellRoot"
        RowDefinitions="Auto,*,Auto"
        ColumnDefinitions="*"
        Background="{DynamicResource CanvasBrush}">

    <!-- KoLmafia-style menu bar: the sections live in a row at the top,
         the way a KoL player expects them. -->
    <Border x:Name="MenuBar"
            Grid.Row="0"
            Classes="shell-header"
            BorderThickness="0,0,0,1"
            Padding="14,8">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <TextBlock Text="KoLibri"
                     FontSize="17"
                     FontWeight="Bold"
                     Foreground="{DynamicResource InkBrush}"
                     VerticalAlignment="Center"
                     Margin="0,0,16,0" />
          <Button x:Name="NavOverview"
                  Classes="menu-item"
                  Content="Guts"
                  Tag="Guts"
                  Click="GutsClick"
                  AutomationProperties.Name="Open guts" />
          <Button x:Name="NavInventory"
                  Classes="menu-item"
                  Content="Inventory"
                  Tag="Inventory"
                  Click="InventoryClick"
                  AutomationProperties.Name="Open inventory" />
          <Button x:Name="NavDaily"
                  Classes="menu-item"
                  Content="Daily"
                  Tag="Daily"
                  Click="DailyClick"
                  AutomationProperties.Name="Open the daily routine" />
          <Button x:Name="NavArbitrage"
                  Classes="menu-item"
                  Content="Arbitrage"
                  Tag="Arbitrage"
                  Click="ArbitrageClick"
                  AutomationProperties.Name="Open arbitrage" />
          <Button x:Name="NavMall"
                  Classes="menu-item"
                  Content="Mall"
                  Tag="Mall &amp; Shop"
                  Click="MallClick"
                  AutomationProperties.Name="Open mall and shop" />
          <Button x:Name="NavAdventure"
                  Classes="menu-item"
                  Content="Adventures"
                  Tag="Adventure"
                  Click="AdventureClick"
                  AutomationProperties.Name="Open adventures" />
          <Button x:Name="NavCombat"
                  Classes="menu-item"
                  Content="Combat"
                  Tag="Combat"
                  Click="CombatClick"
                  AutomationProperties.Name="Open combat" />
        </StackPanel>

        <StackPanel Grid.Column="1" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="Account" Classes="muted" FontSize="10" />
            <ComboBox x:Name="AccountRoleSelector"
                      Width="112"
                      SelectedIndex="1"
                      SelectionChanged="AccountRoleSelectionChanged"
                      AutomationProperties.Name="Select the active account">
              <ComboBoxItem Content="Main" />
              <ComboBoxItem Content="Mallbot" />
            </ComboBox>
          </StackPanel>
          <Button x:Name="GlobalRefreshButton"
                  Classes="secondary"
                  Content="⟳"
                  Click="RefreshClick"
                  AutomationProperties.Name="Daten aktualisieren" />
          <Button x:Name="ThemeToggleButton"
                  Classes="secondary"
                  Content="☾"
                  Click="ThemeToggleClick"
                  AutomationProperties.Name="Theme wechseln" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="ContentRoot"
                  Margin="{DynamicResource ComfortableContentMargin}"
                  Spacing="24">
        <StackPanel x:Name="ShellHeader" Spacing="0">
          <StackPanel>
            <TextBlock x:Name="ShellPageTitle" Text="Good morning" Classes="h1" />
            <TextBlock x:Name="ShellPageDescription" Text="Your arbitrage overview for today."
                       Classes="muted"
                       FontSize="14"
                       Margin="0,6,0,0" />
          </StackPanel>
        </StackPanel>

        <StackPanel x:Name="GutsPanel" Spacing="16" IsVisible="False">

          <Border Classes="card">
            <StackPanel Spacing="6">
              <TextBlock Text="Guts" Classes="h2" />
              <TextBlock x:Name="GutsSummaryText"
                         Text="—"
                         Classes="muted"
                         FontSize="13" />
            </StackPanel>
          </Border>

          <ItemsControl x:Name="GutsAccountCards">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:GutsAccountCard">
                <Border Classes="card" Width="280" Margin="0,0,12,12">
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding PlayerName}" FontWeight="SemiBold" FontSize="15" />
                      <TextBlock Text="{Binding Role}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding MeatText}" Classes="kpi" FontSize="20" />
                    <TextBlock Text="{Binding AdventuresText}" Classes="muted" FontSize="12" />
                    <TextBlock Text="{Binding InventoryText}" Classes="muted" FontSize="12" />
                    <TextBlock Text="{Binding FreshnessText}" Classes="muted" FontSize="11" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Classes="card" Padding="0">
            <Grid RowDefinitions="Auto,*">
              <StackPanel Grid.Row="0" Margin="14,12,14,8">
                <TextBlock Text="Own store" Classes="muted" FontSize="11" FontWeight="SemiBold" />
                <TextBlock x:Name="StoreSummaryText" Text="—" Classes="muted" FontSize="12" />
              </StackPanel>
              <ListBox x:Name="StoreRows"
                       Grid.Row="1"
                       AutomationProperties.Name="Own store listings">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:LiveShopRow">
                    <Grid ColumnDefinitions="2*,Auto,Auto" ColumnSpacing="12" Margin="0,3">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding ItemName}" />
                        <TextBlock Text="{Binding ItemId}" Classes="muted" FontSize="11" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding PriceText}" />
                      <TextBlock Grid.Column="2" Text="{Binding QuantityText}" Classes="muted" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

        </StackPanel>

        <StackPanel x:Name="ArbitragePanel" Spacing="16" IsVisible="False">

          <Border Classes="card">
            <StackPanel Spacing="6">
              <TextBlock Text="Arbitrage" Classes="h2" />
              <TextBlock x:Name="ArbitrageSummaryText"
                         Text="—"
                         Classes="muted"
                         FontSize="13" />
              <TextBlock Text="Live mall listings against the pricegun median. Buying stays behind the approval token."
                         Classes="muted"
                         FontSize="12"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Classes="card" Padding="0">
            <Grid RowDefinitions="Auto,*">
              <Grid Grid.Row="0"
                    ColumnDefinitions="2*,Auto,Auto,Auto"
                    Margin="14,12,14,8">
                <TextBlock Grid.Column="0" Text="Item" Classes="muted" FontSize="11" />
                <TextBlock Grid.Column="1" Text="Cheapest" Classes="muted" FontSize="11" />
                <TextBlock Grid.Column="2" Text="Spread" Classes="muted" FontSize="11" />
                <TextBlock Grid.Column="3" Text="Margin" Classes="muted" FontSize="11" />
              </Grid>
              <ListBox x:Name="ArbitrageRows"
                       Grid.Row="1"
                       AutomationProperties.Name="Arbitrage candidates">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:LiveArbitrageRow">
                    <Grid ColumnDefinitions="2*,Auto,Auto,Auto" ColumnSpacing="12" Margin="0,3">
                      <TextBlock Grid.Column="0" Text="{Binding ItemName}" />
                      <TextBlock Grid.Column="1" Text="{Binding CheapestPrice}" />
                      <TextBlock Grid.Column="2" Text="{Binding SpreadText}" />
                      <TextBlock Grid.Column="3" Text="{Binding MarginText}" Classes="muted" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

        </StackPanel>

        <StackPanel x:Name="DailyPanel" Spacing="16" IsVisible="False">

          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Text="Daily briefing" Classes="h2" />
              <TextBlock x:Name="DailySnapshotText"
                         Text="—"
                         Classes="muted"
                         FontSize="13" />
              <TextBlock x:Name="DailySummaryText"
                         Text="—"
                         Classes="muted"
                         FontSize="12" />
            </StackPanel>
          </Border>

          <Border Classes="card" Padding="0">
            <Grid RowDefinitions="Auto,*">
              <Grid Grid.Row="0"
                    ColumnDefinitions="140,2*,3*,110"
                    Margin="14,12,14,8">
                <TextBlock Grid.Column="0" Text="Area" Classes="muted" FontSize="11" />
                <TextBlock Grid.Column="1" Text="Action" Classes="muted" FontSize="11" />
                <TextBlock Grid.Column="2" Text="Details" Classes="muted" FontSize="11" />
                <TextBlock Grid.Column="3" Text="Status" Classes="muted" FontSize="11" />
              </Grid>
              <ListBox x:Name="DailyRows"
                       Grid.Row="1"
                       SelectionChanged="DailySelectionChanged"
                       AutomationProperties.Name="Tagesplan">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:DailyBriefingRow">
                    <Grid ColumnDefinitions="140,2*,3*,110" ColumnSpacing="10" Margin="0,3">
                      <TextBlock Grid.Column="0" Text="{Binding Surface}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="{Binding Description}" />
                      <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="muted" />
                      <TextBlock Grid.Column="3" Text="{Binding State}" Classes="muted" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Text="Execution" Classes="muted" FontSize="11" FontWeight="SemiBold" />
              <TextBlock Text="Live-Aktionen brauchen einen Approval-Token. Der Token liegt in ~/.local/share/KoLibri/approval-token.json und wird nie im Fenster angezeigt."
                         Classes="muted"
                         FontSize="12"
                         TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="DailyTokenBox"
                         Width="280"
                         PasswordChar="•"
                         Watermark="Approval-Token (optional)"
                         AutomationProperties.Name="Approval token for the daily routine" />
                <Button x:Name="DailyRunButton"
                        Classes="primary"
                        Content="▶  Run the daily routine"
                        Click="DailyRunClick"
                        AutomationProperties.Name="Run the daily routine" />
              </StackPanel>
              <TextBlock x:Name="DailyStatusText"
                         Text="Nothing executed yet."
                         Classes="muted"
                         FontSize="12"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

        </StackPanel>

        <StackPanel x:Name="InventoryPanel" Spacing="16" IsVisible="False">
          <Border Classes="card">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Spacing="8">
                <TextBlock Text="Inventory" Classes="h2" />
                <TextBlock x:Name="InventorySummaryText"
                           Text="No entries."
                           Classes="muted"
                           FontSize="13" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                <TextBox x:Name="InventorySearchBox"
                         Width="240"
                         Watermark="Suchen (Name oder ID) …"
                         TextChanged="InventorySearchChanged"
                         AutomationProperties.Name="Inventar durchsuchen" />
                <TextBlock x:Name="InventoryLoadedText"
                           Text="—"
                           Classes="muted"
                           FontSize="11"
                           HorizontalAlignment="Right" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Classes="card" Padding="8,6">
            <StackPanel x:Name="InventoryCategoryStrip" Orientation="Horizontal" Spacing="4" />
          </Border>

          <Grid ColumnDefinitions="2*,3*" ColumnSpacing="14" MinHeight="420">

            <Border Classes="card" Padding="0">
              <Grid RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0"
                           Text="Items"
                           Classes="muted"
                           Margin="14,12,14,8" />
                <ListBox x:Name="InventoryList"
                         Grid.Row="1"
                         SelectionChanged="InventorySelectionChanged"
                         AutomationProperties.Name="Inventar-Liste">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:DesktopInventoryItem">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}"
                                     VerticalAlignment="Center" />
                          <TextBlock Text="{Binding ItemId}"
                                     Classes="muted"
                                     FontSize="11"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Quantity}"
                                   Classes="muted"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>

            <Border Grid.Column="1" Classes="card">
              <StackPanel x:Name="InventoryDetailPanel" Spacing="10">
                <TextBlock Text="No item selected" Classes="muted" />
              </StackPanel>
            </Border>

          </Grid>

        </StackPanel>

        <StackPanel x:Name="OverviewPanel" Spacing="24">

          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="Knucklebones heute" Classes="muted" />
                <TextBlock Text="42 / 100" Classes="kpi" Foreground="{DynamicResource AdventureBrush}" />
                <ProgressBar Value="42" Maximum="100" Height="7" />
                <TextBlock Text="Next run: in 18 min."
                           Classes="muted"
                           FontSize="12" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="Preisquellen-Cache" Classes="muted" />
                <TextBlock Text="96 % frisch" Classes="kpi" Foreground="{DynamicResource SuccessBrush}" />
                <TextBlock Text="Letzter Abgleich vor 4 Min."
                           Classes="muted"
                           FontSize="12" />
                <TextBlock Text="Pricegun · Mall · Shop"
                           Classes="muted"
                           FontSize="12" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="Kaufkandidaten" Classes="muted" />
                <TextBlock Text="7" Classes="kpi" Foreground="{DynamicResource MeatBrush}" />
                <TextBlock Text="over 20 % expected margin"
                           Classes="muted"
                           FontSize="12" />
                <TextBlock Text="3 need a detail price"
                           Classes="muted"
                           FontSize="12" />
              </StackPanel>
            </Border>
          </Grid>

          <Grid ColumnDefinitions="1.2*,*" ColumnSpacing="14">
            <Border Classes="card">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <StackPanel>
                    <TextBlock Text="Arbitrage-Pipeline" Classes="h2" />
                    <TextBlock Text="Priorisierte Aktionen aus dem letzten Scan"
                               Classes="muted"
                               FontSize="12" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Content="Alle anzeigen →"
                          Classes="secondary"
                          Foreground="{DynamicResource AccentBrush}"
                          Click="PricingClick"
                          AutomationProperties.Name="Alle Pricing-Aktionen anzeigen" />
                </Grid>
                <Grid ColumnDefinitions="2*,*,*,Auto"
                      RowDefinitions="Auto,Auto,Auto"
                      RowSpacing="12">
                  <TextBlock Text="Artikel" Classes="muted" FontSize="12" />
                  <TextBlock Grid.Column="1" Text="Einkauf" Classes="muted" FontSize="12" />
                  <TextBlock Grid.Column="2" Text="Zielpreis" Classes="muted" FontSize="12" />
                  <TextBlock Grid.Column="3" Text="Score" Classes="muted" FontSize="12" />
                  <TextBlock Grid.Row="1"
                             Text="Tiny Plastic Figure · Set A"
                             Classes="body" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="12 000 meat" Classes="body" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="18 500 meat" Foreground="{DynamicResource SuccessBrush}" />
                  <TextBlock Grid.Row="1" Grid.Column="3" Text="92" Foreground="{DynamicResource MeatBrush}" />
                  <TextBlock Grid.Row="2" Text="Pirate Encryption Key" Classes="body" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="8 400 meat" Classes="body" />
                  <TextBlock Grid.Row="2" Grid.Column="2" Text="11 200 meat" Foreground="{DynamicResource SuccessBrush}" />
                  <TextBlock Grid.Row="2" Grid.Column="3" Text="81" Foreground="{DynamicResource MeatBrush}" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Systemstatus" Classes="h2" />
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                  <TextBlock Text="Main-Account" Classes="body" />
                  <Border Grid.Column="1" Classes="badge warning">
                    <TextBlock Text="Simulation" Classes="badge-text warning" />
                  </Border>
                  <TextBlock Grid.Row="1" Text="Mallbot" Classes="body" />
                  <Border Grid.Row="1" Grid.Column="1" Classes="badge warning">
                    <TextBlock Text="Simulation" Classes="badge-text warning" />
                  </Border>
                  <TextBlock Grid.Row="2" Text="Letzte Aktion" Classes="muted" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="vor 4 Min." Classes="muted" />
                </Grid>
                <Border Classes="panel-subtle" Margin="0,5,0,0">
                  <TextBlock Text="Automatisches Kaufen bleibt bis zur Freigabe im Simulationsmodus."
                             TextWrapping="Wrap"
                             Classes="muted"
                             FontSize="12" />
                </Border>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>

        <Border x:Name="PageStatePanel" Classes="card" IsVisible="False">
          <StackPanel Spacing="10">
            <TextBlock x:Name="PageStateTitle" Text="Area" Classes="h2" />
            <TextBlock x:Name="PageStateDescription"
                       Classes="muted"
                       TextWrapping="Wrap" />
            <Border Classes="panel-subtle">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <TextBlock Text="Datenstatus" Classes="muted" />
                <TextBlock x:Name="PageStateStatus"
                           Grid.Column="1"
                           Classes="body"
                           Text="Noch keine Daten geladen."
                           TextWrapping="Wrap" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <Border x:Name="AccountsPanel" Classes="card" IsVisible="False">
          <StackPanel Spacing="14">
            <StackPanel Spacing="3">
              <TextBlock Text="Konten verbinden" Classes="h2" />
              <TextBlock Text="KoLibri logs both roles in at KoL directly. User name and session cookies are stored encrypted; the password can be stored encrypted as well."
                         Classes="muted"
                         TextWrapping="Wrap"
                         FontSize="12" />
            </StackPanel>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
              <Border Classes="panel-subtle">
                <StackPanel Spacing="8">
                  <TextBlock Text="Main" Classes="h2" FontSize="16" />
                  <TextBox x:Name="MainUsername" Watermark="Benutzername" AutomationProperties.Name="Main Benutzername" />
                  <TextBox x:Name="MainPassword" Watermark="Passwort" PasswordChar="●" AutomationProperties.Name="Main Passwort" />
                  <CheckBox x:Name="MainRememberPassword" Content="Store the password encrypted" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="MainAccountStatus"
                               Text="Noch nicht gespeichert"
                               Classes="muted"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="Login &amp; speichern"
                            Tag="Main"
                            Click="SaveAccountClick"
                            Classes="primary"
                            AutomationProperties.Name="Main anmelden und speichern" />
                  </Grid>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="panel-subtle">
                <StackPanel Spacing="8">
                  <TextBlock Text="Mallbot" Classes="h2" FontSize="16" />
                  <TextBox x:Name="MallbotUsername" Watermark="Benutzername" AutomationProperties.Name="Mallbot Benutzername" />
                  <TextBox x:Name="MallbotPassword" Watermark="Passwort" PasswordChar="●" AutomationProperties.Name="Mallbot Passwort" />
                  <CheckBox x:Name="MallbotRememberPassword" Content="Store the password encrypted" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="MallbotAccountStatus"
                               Text="Noch nicht gespeichert"
                               Classes="muted"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="Login &amp; speichern"
                            Tag="Mallbot"
                            Click="SaveAccountClick"
                            Classes="primary"
                            AutomationProperties.Name="Mallbot anmelden und speichern" />
                  </Grid>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </Border>

        <Border x:Name="MallPanel" Classes="card" IsVisible="False">
          <Border.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Preisvergleich vorschauen" Click="ContextPreviewClick" />
              <MenuItem Header="Mall aktualisieren" Click="RefreshMallClick" />
            </ContextMenu>
          </Border.ContextMenu>
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="3">
                <TextBlock Text="Mall &amp; eigener Shop" Classes="h2" />
                <TextBlock Text="Read-only overview with cache; no listing is changed."
                           Classes="muted"
                           TextWrapping="Wrap"
                           FontSize="12" />
                <TextBlock x:Name="MallRoleLabel"
                           Text="Konto: Mallbot"
                           Classes="muted"
                           FontSize="12" />
              </StackPanel>
              <Button Grid.Column="1"
                      Content="⟳  Mall aktualisieren"
                      Click="RefreshMallClick"
                      Classes="primary"
                      AutomationProperties.Name="Mall aktualisieren" />
            </Grid>
            <TextBlock x:Name="MallSummary" Text="Noch keine Mall-Daten geladen." Classes="muted" />
            <TextBlock x:Name="MallRows" TextWrapping="Wrap" Classes="body" />
          </StackPanel>
        </Border>

        <Border x:Name="AdventurePanel" Classes="card" IsVisible="False">
          <Border.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Encounter-/Planvorschau" Click="ContextPreviewClick" />
              <MenuItem Header="Adventure-Plan aktualisieren" Click="RefreshAdventureClick" />
              <Separator />
              <MenuItem Header="Lokalen Lauf stoppen" Click="CancelRefreshClick" />
            </ContextMenu>
          </Border.ContextMenu>
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="3">
                <TextBlock Text="Adventure &amp; Farm" Classes="h2" />
                <TextBlock Text="Fresh status and inventory read plus the bounded daily plan; execution stays separately gated."
                           Classes="muted" TextWrapping="Wrap" FontSize="12" />
              </StackPanel>
              <Button Grid.Column="1" Content="⟳  Plan aktualisieren"
                      Click="RefreshAdventureClick" Classes="primary"
                      AutomationProperties.Name="Adventure-Plan aktualisieren" />
            </Grid>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
              <Border Classes="panel-subtle">
                <StackPanel Spacing="4">
                  <TextBlock Text="Account" Classes="muted" />
                  <TextBlock x:Name="AdventureAccountLabel" Text="Mallbot" Classes="body" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="panel-subtle">
                <StackPanel Spacing="4">
                  <TextBlock Text="Adventures" Classes="muted" />
                  <TextBlock x:Name="AdventureTurnsLabel" Text="—" Classes="body" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="panel-subtle">
                <StackPanel Spacing="4">
                  <TextBlock Text="Knucklebones" Classes="muted" />
                  <TextBlock x:Name="AdventureKnucklebonesLabel" Text="— / 100" Classes="body" />
                </StackPanel>
              </Border>
            </Grid>
            <Border Classes="panel-subtle">
              <StackPanel Spacing="6">
                <TextBlock Text="Manuelle Adventure-Browser" Classes="h3" />
                <TextBlock Text="Catalog from the KoLmafia data. A double click starts the adventure, a double click on an action sends the next step. The token stays in the ApprovalTokenStore."
                           Classes="muted" TextWrapping="Wrap" FontSize="12" />
                <Grid ColumnDefinitions="*,2*" ColumnSpacing="12">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Approval-Token" Classes="muted" />
                    <TextBox x:Name="EncounterTokenBox" Watermark="opaque token" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button x:Name="EncounterSaveTokenButton" Content="Speichern" Classes="secondary" />
                      <Button x:Name="EncounterLoadTokenButton" Content="Aus Store laden" Classes="secondary" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="Filter (Location)" Classes="muted" />
                    <TextBox x:Name="EncounterFilterBox" Watermark="z. B. skeleton" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button x:Name="EncounterStartButton" Content="Start" Classes="primary" />
                      <Button x:Name="EncounterSubmitButton" Content="Step senden" Classes="secondary" />
                      <Button x:Name="EncounterEndButton" Content="Beenden" Classes="secondary" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" MinHeight="240">
                  <DockPanel>
                    <TextBlock Text="Locations" Classes="muted" DockPanel.Dock="Top" />
                    <ListBox x:Name="EncounterLocationsGrid" />
                  </DockPanel>
                  <DockPanel Grid.Column="1">
                    <TextBlock Text="Monsters" Classes="muted" DockPanel.Dock="Top" />
                    <ListBox x:Name="EncounterMonstersGrid" />
                  </DockPanel>
                  <DockPanel Grid.Column="2">
                    <TextBlock Text="Actions" Classes="muted" DockPanel.Dock="Top" />
                    <ListBox x:Name="EncounterActionsGrid" />
                  </DockPanel>
                </Grid>
                <Border Classes="panel-subtle" Padding="10">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Status / Step-Log" Classes="muted" />
                    <TextBlock x:Name="EncounterStatusText" Text="(no adventure session yet)" Classes="body" TextWrapping="Wrap" />
                    <TextBlock x:Name="EncounterStepLogText" Classes="body" TextWrapping="Wrap" FontFamily="monospace" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <Border Classes="panel-subtle">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Tagesplan" Classes="body" />
                  <Border Grid.Column="1" Classes="badge info">
                    <TextBlock Text="Preview only" Classes="badge-text info" />
                  </Border>
                </Grid>
                <TextBlock x:Name="AdventurePlanSummary" Text="Noch kein Snapshot geladen."
                           Classes="muted" TextWrapping="Wrap" />
                <TextBlock x:Name="AdventurePlanAdvisories" Classes="muted"
                           TextWrapping="Wrap" FontSize="12" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Border x:Name="CombatPanel" Classes="card" IsVisible="False">
          <Border.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Kampfaktion vorschauen" Click="ContextPreviewClick" />
              <MenuItem Header="Observation aktualisieren" Click="ContextRefreshClick" />
              <Separator />
              <MenuItem Header="Kampf stoppen" Click="CancelRefreshClick" />
            </ContextMenu>
          </Border.ContextMenu>
          <StackPanel Spacing="14">
            <StackPanel Spacing="3">
              <TextBlock Text="Combat" Classes="h2" />
              <TextBlock Text="Manuelle und AutoCombat-Entscheidungen werden aus dem aktuellen Fight-Snapshot previewt."
                         Classes="muted" TextWrapping="Wrap" FontSize="12" />
            </StackPanel>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
              <Border Classes="panel-subtle">
                <StackPanel Spacing="4">
                  <TextBlock Text="Modus" Classes="muted" />
                  <TextBlock Text="Manual / AutoCombat" Classes="body" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="panel-subtle">
                <StackPanel Spacing="4">
                  <TextBlock Text="Policy" Classes="muted" />
                  <TextBlock Text="deterministisch · allowlisted" Classes="body" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="panel-subtle">
                <StackPanel Spacing="4">
                  <TextBlock Text="Mutation" Classes="muted" />
                  <TextBlock Text="Approval erforderlich" Classes="body" />
                </StackPanel>
              </Border>
            </Grid>
            <Border Classes="panel-subtle">
              <StackPanel Spacing="6">
                <TextBlock Text="Next action" Classes="body" />
                <TextBlock x:Name="CombatPreviewSummary"
                           Text="Noch keine Combat-Observation geladen."
                           Classes="muted" TextWrapping="Wrap" />
                <TextBlock Text="CLI: combat manual · MCP: kol_autocombat_action_preview"
                           Classes="muted" FontSize="12" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <Border x:Name="StatusBar"
            Grid.Row="2"
            Classes="shell-header"
            BorderThickness="0,1,0,0"
            Padding="14,6">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
        <TextBlock x:Name="StatusText"
                   Grid.Column="0"
                   Classes="body"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap" />
        <ProgressBar x:Name="BusyIndicator"
                     Grid.Column="1"
                     Width="100"
                     Height="6"
                     HorizontalAlignment="Left"
                     IsIndeterminate="True"
                     IsVisible="False"
                     AutomationProperties.Name="Refreshing" />
        <Button x:Name="CancelRefreshButton"
                Grid.Column="2"
                Classes="secondary"
                Content="Abbrechen"
                IsVisible="False"
                Click="CancelRefreshClick"
                AutomationProperties.Name="Aktualisierung abbrechen" />
      </Grid>
    </Border>

  </Grid>
</Window>
