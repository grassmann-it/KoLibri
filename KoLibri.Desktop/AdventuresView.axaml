<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KoLibri.Desktop"
             x:Class="KoLibri.Desktop.AdventuresView">
  <UserControl.Styles>
    <Style Selector="Button.location-star">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="Button.location-star:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
  </UserControl.Styles>
  <Border Classes="card">
    <StackPanel Spacing="14">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="3">
          <TextBlock Text="Adventure &amp; Farm" Classes="h2" />
          <TextBlock Text="Fresh status and inventory read plus the bounded daily plan; execution stays separately gated."
                     Classes="muted" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
        <Button Grid.Column="1" Content="⟳  Refresh plan"
                Click="RefreshClick" Classes="primary"
                AutomationProperties.Name="Adventure-Refresh plan" />
      </Grid>
      <!-- Primary task first: pick a place, set turns, start. Everything else follows or folds away. -->
      <Border Classes="panel-subtle">
        <StackPanel Spacing="8">
          <TextBlock Text="Manual adventures" Classes="h3" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="14" x:Name="AdventureTopGrid">
            <StackPanel Spacing="6">
              <!-- Location picker: type to search, arrows to move, Enter to choose; Favorites and Recent on top, then zones. -->
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Location" Classes="muted" />
                <TextBlock Grid.Column="1" x:Name="LocationPickerSelected" Classes="muted" FontSize="11"
                           TextTrimming="CharacterEllipsis" MaxWidth="260" />
              </Grid>
              <TextBox x:Name="EncounterFilterBox" Watermark="Search location, zone or number (e.g. skel, 439)"
                       AutomationProperties.Name="Search locations" />
              <TextBlock x:Name="LocationPickerEmpty" Classes="muted" FontSize="12" IsVisible="False" TextWrapping="Wrap" />
              <ListBox x:Name="EncounterLocationsGrid" MinHeight="150" MaxHeight="260" AutomationProperties.Name="Locations">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="6,2" />
                    <Setter Property="MinHeight" Value="0" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:LocationPickerEntry">
                    <Panel ToolTip.Tip="{Binding Tip}">
                      <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsHeader}" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Chevron}" Classes="muted" Width="14" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" FontSize="12"
                                   Classes="muted" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding CountText}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsLocation}" Opacity="{Binding RowOpacity}" Margin="14,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="location-star" Content="{Binding Star}" Tag="{Binding}"
                                ToolTip.Tip="{Binding StarTip}" AutomationProperties.Name="{Binding StarTip}"
                                Focusable="False" />
                      </Grid>
                    </Panel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="↑↓ move · Enter choose · ☆ favorite" Classes="muted" FontSize="11" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock Text="Turns" Classes="muted" />
              <NumericUpDown x:Name="EncounterBatchTurns" Value="100" Minimum="1" Maximum="1000"
                             HorizontalAlignment="Stretch" AutomationProperties.Name="Adventure turn budget" />
              <TextBlock Text="Stop when this item is owned (optional)" Classes="muted" TextWrapping="Wrap" />
              <TextBox x:Name="EncounterBatchItem" Watermark="Item ID" AutomationProperties.Name="Stop item" />
              <WrapPanel>
                <Button x:Name="EncounterBatchStart" Content="Run turns" Classes="primary" Margin="0,0,6,6" />
                <Button x:Name="EncounterStartButton" Content="Adventure once" Classes="secondary" Margin="0,0,6,6" />
                <Button x:Name="EncounterBatchContinue" Content="Continue remaining turns" Classes="secondary" Margin="0,0,6,6" />
              </WrapPanel>
              <WrapPanel>
                <Button x:Name="EncounterSubmitButton" Content="Submit action" Classes="secondary" Margin="0,0,6,6" />
                <Button x:Name="EncounterRecheckButton" Content="Recheck encounter" Classes="secondary" Margin="0,0,6,6" />
                <Button x:Name="EncounterFightButton" Content="Fight encounter" Classes="secondary" Click="CombatRunClick" Margin="0,0,6,6" AutomationProperties.Name="Fight the open encounter with the auto-combat rules from settings" />
                <Button x:Name="EncounterEndButton" Content="End run" Classes="secondary" Margin="0,0,6,6" />
              </WrapPanel>
            </StackPanel>
          </Grid>
          <Border x:Name="DecisionPanel" Classes="panel-subtle" Padding="10" IsVisible="False">
            <StackPanel Spacing="6">
              <TextBlock x:Name="DecisionTitle" Text="Open choice" Classes="h3" TextWrapping="Wrap" />
              <TextBlock x:Name="DecisionMessage" Classes="muted" TextWrapping="Wrap" />
              <ItemsControl x:Name="DecisionOptions">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:DecisionOptionRow">
                    <Button Content="{Binding Label}" Tag="{Binding Number}" Margin="0,0,0,4"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            AutomationProperties.Name="Choose this option" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button x:Name="DecisionApplyPolicy" Content="Apply policy" Classes="secondary" />
                <Button x:Name="DecisionRefresh" Content="Re-read choice" Classes="secondary" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="panel-subtle" Padding="10">
            <StackPanel Spacing="4">
              <TextBlock Text="Status / Step-Log" Classes="muted" />
              <TextBlock x:Name="EncounterStatusText" Text="(no adventure session yet)" Classes="body" TextWrapping="Wrap" />
              <TextBlock x:Name="EncounterStepLogText" Classes="body" TextWrapping="Wrap" FontFamily="monospace" />
            </StackPanel>
          </Border>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <DockPanel>
              <TextBlock Text="Monsters" Classes="muted" DockPanel.Dock="Top" />
              <ListBox x:Name="EncounterMonstersGrid" MinHeight="110" MaxHeight="220">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:EncounterBrowserMonsterRow">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
            <DockPanel Grid.Column="1">
              <TextBlock Text="Actions" Classes="muted" DockPanel.Dock="Top" />
              <ListBox x:Name="EncounterActionsGrid" MinHeight="110" MaxHeight="220">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:EncounterBrowserActionRow">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Grid>
        </StackPanel>
      </Border>
      <Expander x:Name="FarmFiguresExpander" Header="Farm figures and plan" IsVisible="False">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
            <Border Classes="panel-subtle">
              <StackPanel Spacing="4">
                <TextBlock Text="Account" Classes="muted" />
                <TextBlock x:Name="AdventureAccountLabel" Text="Mallbot" Classes="body" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="panel-subtle">
              <StackPanel Spacing="4">
                <TextBlock Text="Adventures" Classes="muted" />
                <TextBlock x:Name="AdventureTurnsLabel" Text="—" Classes="body" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="panel-subtle">
              <StackPanel Spacing="4">
                <TextBlock Text="Knucklebones" Classes="muted" />
                <TextBlock x:Name="AdventureKnucklebonesLabel" Text="— / 100" Classes="body" />
              </StackPanel>
            </Border>
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Farm plan" Classes="body" />
            <Border Grid.Column="1" Classes="badge info">
              <TextBlock Text="Preview only" Classes="badge-text info" />
            </Border>
          </Grid>
          <TextBlock x:Name="AdventurePlanSummary" Text="Waiting for account data."
                     Classes="muted" TextWrapping="Wrap" />
          <TextBlock x:Name="AdventurePlanAdvisories" Classes="muted"
                     TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
      </Expander>
      <Expander Header="Deep Fat Friars">
        <StackPanel Spacing="6">
          <TextBlock x:Name="FriarsPageStatus" TextWrapping="Wrap" />
          <WrapPanel>
            <Button Content="Open Friars" Click="OpenFriarsClick" />
            <Button x:Name="FriarRitualButton" Content="Perform ritual" Click="FriarRitualClick" IsEnabled="False" />
            <Button x:Name="FriarFoodButton" Content="Food blessing" Click="FriarBlessingClick" Tag="Food" IsEnabled="False" />
            <Button x:Name="FriarFamiliarButton" Content="Familiar blessing" Click="FriarBlessingClick" Tag="Familiar" IsEnabled="False" />
            <Button x:Name="FriarBoozeButton" Content="Booze blessing" Click="FriarBlessingClick" Tag="Booze" IsEnabled="False" />
          </WrapPanel>
        </StackPanel>
      </Expander>
    </StackPanel>
  </Border>
</UserControl>
