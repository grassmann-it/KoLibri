<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KoLibri.Desktop"
             x:Class="KoLibri.Desktop.MallSearchView"
             x:DataType="local:MallSearchViewModel">
  <UserControl.Styles>
    <Style Selector="Grid.bargain">
      <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="14">

    <Border Classes="card">
      <StackPanel Spacing="8">
        <TextBlock Text="Mall search" Classes="h2" />
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
          <TextBox x:Name="SearchBox"
                   Text="{Binding SearchText, Mode=TwoWay}"
                   Watermark="Item name (partial is fine) or item ID"
                   KeyDown="SearchBoxKeyDown"
                   AutomationProperties.Name="Mall search term" />
          <Button x:Name="SearchButton" Grid.Column="1" Content="Search" Classes="primary"
                  Click="SearchClick" />
          <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel"
                  IsVisible="{Binding CanCancel}" Click="CancelClick" />
          <Button x:Name="CloverButton" Grid.Column="3" Content="11-leaf clover" Classes="secondary"
                  Click="CloverClick"
                  ToolTip.Tip="Searches the 11-leaf clover and highlights offers at or under the price threshold (Settings)." />
        </Grid>
        <TextBlock Text="{Binding StatusText}" Classes="muted" TextWrapping="Wrap" />
        <Border x:Name="ErrorBanner" IsVisible="{Binding HasSearchError}"
                Background="{DynamicResource ErrorSoftBrush}" BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1"
                CornerRadius="6" Padding="10,6">
          <TextBlock Text="{Binding SearchError}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                     AutomationProperties.Name="Search error" />
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasUnclear}">
          <Button x:Name="ReconcileButton" Content="Reconcile unclear purchases" Classes="secondary"
                  Click="ReconcileClick" AutomationProperties.Name="Reconcile unclear purchases" />
          <TextBlock Text="{Binding UnclearText}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{Binding Notice}" IsVisible="{Binding HasNotice}"
                   Classes="muted" TextWrapping="Wrap" FontSize="12" />
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding HasPurchases}">
      <StackPanel Spacing="6">
        <TextBlock Text="Purchases" Classes="h2" />
        <TextBlock Text="{Binding PurchasesTotal}" Classes="muted" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Purchases}" AutomationProperties.Name="Queued purchases">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:MallBuyTicket">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,4">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding StateText}" FontWeight="SemiBold" Margin="10,0,0,0"
                           IsVisible="{Binding !IsProblem}" />
                <TextBlock Grid.Column="1" Text="{Binding StateText}" FontWeight="SemiBold" Margin="10,0,0,0"
                           Foreground="{DynamicResource ErrorBrush}" IsVisible="{Binding IsProblem}" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Message}" Classes="muted" FontSize="12"
                           TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding NeedsPick}">
      <StackPanel Spacing="6">
        <TextBlock Text="Pick item" Classes="h2" />
        <ListBox x:Name="ChoiceList" ItemsSource="{Binding Choices}" MaxHeight="260"
                 DoubleTapped="ChoiceActivated" KeyDown="ChoiceKeyDown"
                 AutomationProperties.Name="Matching items">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="local:MallItemChoice">
              <TextBlock Text="{Binding Label}" Margin="0,3" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Content="Show offers for selected item" HorizontalAlignment="Left" Click="ChoiceClick" />
      </StackPanel>
    </Border>

    <Border Classes="card" Padding="0" IsVisible="{Binding HasOffers}">
      <StackPanel>
        <!-- Sortable columns: one click sorts, a second click flips the direction. -->
        <WrapPanel Margin="14,10,14,4">
          <TextBlock Text="Sort by" Classes="muted" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
          <Button Content="{Binding RankHeader}" Tag="Rank" Click="SortClick" Classes="secondary" Padding="8,2" Margin="0,0,4,4" AutomationProperties.Name="Sort by rank" />
          <Button Content="{Binding ShopHeader}" Tag="Shop" Click="SortClick" Classes="secondary" Padding="8,2" Margin="0,0,4,4" AutomationProperties.Name="Sort by shop" />
          <Button Content="{Binding PriceHeader}" Tag="Price" Click="SortClick" Classes="secondary" Padding="8,2" Margin="0,0,4,4" AutomationProperties.Name="Sort by price" />
          <Button Content="{Binding StockHeader}" Tag="Stock" Click="SortClick" Classes="secondary" Padding="8,2" Margin="0,0,4,4" AutomationProperties.Name="Sort by stock" />
          <Button Content="{Binding LimitHeader}" Tag="Limit" Click="SortClick" Classes="secondary" Padding="8,2" Margin="0,0,4,4" AutomationProperties.Name="Sort by daily limit" />
          <Button Content="{Binding MedianHeader}" Tag="Median" Click="SortClick" Classes="secondary" Padding="8,2" Margin="0,0,4,4" AutomationProperties.Name="Sort by median" />
        </WrapPanel>
        <Grid ColumnDefinitions="*,Auto" Margin="14,0,14,4">
          <CheckBox x:Name="OnlyBuyableBox" IsChecked="{Binding OnlyBuyable, Mode=TwoWay}" Content="Only buyable offers"
                    AutomationProperties.Name="Only buyable offers" />
          <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="muted" FontSize="12"
                     IsVisible="{Binding HasHiddenOffers}"
                     Text="{Binding HiddenOfferCount, StringFormat='{}{0:N0} hidden'}" />
        </Grid>
        <TextBlock Text="{Binding HighlightThreshold, StringFormat='Highlighted: offers at or under {0:N0} Meat'}"
                   IsVisible="{Binding HasThreshold}" Classes="muted" FontSize="12" Margin="14,0,14,4" />
        <ListBox x:Name="OfferList" ItemsSource="{Binding Offers}" MaxHeight="460"
                 AutomationProperties.Name="Market offers">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="local:MallOfferRow">
              <!-- Two lines per offer, so shop, unit price and Buy stay together at 820 px:
                   shop name wraps instead of being cut, the numbers sit under it. -->
              <Grid ColumnDefinitions="30,*,Auto,58" ColumnSpacing="8" Margin="0,3"
                    Classes.bargain="{Binding UnderThreshold}">
                <TextBlock Grid.Column="0" Text="{Binding RankText}" Classes="muted" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock Text="{Binding ShopName}" TextWrapping="Wrap" ToolTip.Tip="{Binding ShopName}" />
                  <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap">
                    <Run Text="{Binding StockText}" /><Run Text="  ·  " /><Run Text="{Binding LimitText}" /><Run Text="  ·  median " /><Run Text="{Binding PricegunText}" />
                  </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                  <TextBlock Text="{Binding PriceText}" TextAlignment="Right" FontWeight="SemiBold" />
                  <TextBlock Text="Meat / unit" Classes="muted" FontSize="10" TextAlignment="Right" />
                </StackPanel>
                <!-- Disabled when the row cannot be bought. -->
                <Button Grid.Column="3" Content="Buy" Classes="secondary" IsEnabled="{Binding CanBuy}"
                        Click="BuyClick" Padding="8,2" VerticalAlignment="Top"
                        ToolTip.Tip="Opens a confirmation first; nothing is bought until you confirm." />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="{Binding PricegunNote}" IsVisible="{Binding HasPricegunNote}"
                   Classes="muted" FontSize="12" Margin="14,6,14,10" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Expander x:Name="OwnShopExpander" Header="My shop (loads when opened)"
              HorizontalAlignment="Stretch" Expanded="OwnShopExpanded">
      <Border Classes="card" Padding="0">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto" Margin="14,10,14,4">
            <TextBlock x:Name="OwnShopSummary" Text="—" Classes="muted" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Reload" Click="OwnShopReloadClick" />
          </Grid>
          <TextBlock Text="Double-click a listing to search the mall for it." Classes="muted" FontSize="12"
                     Margin="14,0,14,6" />
          <ListBox x:Name="OwnShopRows" MaxHeight="320" DoubleTapped="OwnShopDoubleTapped"
                   AutomationProperties.Name="Own mall listings">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:MallStoreRow">
                <Grid ColumnDefinitions="*,115,95,95" ColumnSpacing="12" Margin="0,3">
                  <TextBlock Text="{Binding ItemName}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding PriceText}" />
                  <TextBlock Grid.Column="2" Text="{Binding QuantityText}" Classes="muted" />
                  <TextBlock Grid.Column="3" Text="{Binding LimitText}" Classes="muted" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>
    </Expander>
  </StackPanel>
</UserControl>
