<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KoLibri.Desktop"
             x:Class="KoLibri.Desktop.SettingsView"
             x:DataType="local:SettingsViewModel">
    <StackPanel Spacing="14" Margin="0,4" MaxWidth="760" HorizontalAlignment="Left">

      <!-- Save stays at the top so it is visible without scrolling. -->
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button x:Name="SettingsSaveButton" Content="Save" Classes="primary" Command="{Binding Save}"/>
        <Button Content="Reset to defaults" Classes="secondary" Command="{Binding ResetDefaults}"/>
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </StackPanel>

      <TextBlock Text="Accounts and access" FontWeight="SemiBold"/>
      <StackPanel Spacing="3" Width="240">
        <TextBlock Text="Default account (opened at start)" FontSize="12" Opacity="0.8"/>
        <ComboBox ItemsSource="{Binding DefaultAccountChoices}" SelectedItem="{Binding DefaultAccountChoice}" HorizontalAlignment="Stretch"
                  AutomationProperties.Name="Default account"/>
      </StackPanel>
      <CheckBox IsChecked="{Binding ReloginAutomatically}" Content="Log in again automatically (at start and when the session expires)"/>
      <TextBlock Text="{Binding AgentRightsNote}" TextWrapping="Wrap" Opacity="0.7"/>

      <TextBlock Text="Market and budget" FontWeight="SemiBold"/>
      <WrapPanel>
        <StackPanel Spacing="3" Width="240" Margin="0,0,12,8">
          <TextBlock Text="Meat per day" FontSize="12" Opacity="0.8"/>
          <NumericUpDown Value="{Binding MeatPerDay}" Minimum="{Binding MeatPerDayMin}" Maximum="{Binding MeatPerDayMax}" FormatString="N0" AutomationProperties.Name="Meat per day"/>
        </StackPanel>
        <StackPanel Spacing="3" Width="240" Margin="0,0,12,8">
          <TextBlock Text="Meat per purchase" FontSize="12" Opacity="0.8"/>
          <NumericUpDown Value="{Binding MeatPerPurchase}" Minimum="{Binding MeatPerPurchaseMin}" Maximum="{Binding MeatPerPurchaseMax}" FormatString="N0" AutomationProperties.Name="Meat per purchase"/>
        </StackPanel>
        <StackPanel Spacing="3" Width="240" Margin="0,0,12,8">
          <TextBlock Text="Units per purchase" FontSize="12" Opacity="0.8"/>
          <NumericUpDown Value="{Binding UnitsPerPurchase}" Minimum="{Binding UnitsPerPurchaseMin}" Maximum="{Binding UnitsPerPurchaseMax}" FormatString="N0" AutomationProperties.Name="Units per purchase"/>
        </StackPanel>
        <StackPanel Spacing="3" Width="240" Margin="0,0,12,8">
          <TextBlock Text="Pricegun sales shown (result limit)" FontSize="12" Opacity="0.8"/>
          <NumericUpDown Value="{Binding ResultLimit}" Minimum="{Binding ResultLimitMin}" Maximum="{Binding ResultLimitMax}" FormatString="N0" AutomationProperties.Name="Pricegun sales shown (result limit)"/>
        </StackPanel>
        <StackPanel Spacing="3" Width="240" Margin="0,0,12,8">
          <TextBlock Text="11-leaf clover highlight price (Meat)" FontSize="12" Opacity="0.8"/>
          <NumericUpDown Value="{Binding CloverThreshold}" Minimum="{Binding CloverThresholdMin}" Maximum="{Binding CloverThresholdMax}" FormatString="N0" AutomationProperties.Name="11-leaf clover highlight price (Meat)"/>
        </StackPanel>
      </WrapPanel>

      <TextBlock Text="Network and cache" FontWeight="SemiBold"/>
      <WrapPanel>
        <StackPanel Spacing="3" Width="240" Margin="0,0,12,8">
          <TextBlock Text="KoL request interval (seconds)" FontSize="12" Opacity="0.8"/>
          <NumericUpDown Value="{Binding KolIntervalSeconds}" Minimum="{Binding IntervalMin}" Maximum="{Binding IntervalMax}" FormatString="0.##" AutomationProperties.Name="KoL request interval"/>
        </StackPanel>
        <StackPanel Spacing="3" Width="240" Margin="0,0,12,8">
          <TextBlock Text="Pricegun request interval (seconds)" FontSize="12" Opacity="0.8"/>
          <NumericUpDown Value="{Binding PricegunIntervalSeconds}" Minimum="{Binding IntervalMin}" Maximum="{Binding IntervalMax}" FormatString="0.##" AutomationProperties.Name="Pricegun request interval"/>
        </StackPanel>
        <StackPanel Spacing="3" Width="240" Margin="0,0,12,8">
          <TextBlock Text="Cache duration (minutes)" FontSize="12" Opacity="0.8"/>
          <NumericUpDown Value="{Binding CacheMinutes}" Minimum="{Binding CacheMinutesMin}" Maximum="{Binding CacheMinutesMax}" FormatString="N0" AutomationProperties.Name="Cache duration (minutes)"/>
        </StackPanel>
        <StackPanel Spacing="3" Width="240" Margin="0,0,12,8">
          <TextBlock Text="Maximum age of stale data (hours)" FontSize="12" Opacity="0.8"/>
          <NumericUpDown Value="{Binding MaxStaleHours}" Minimum="{Binding MaxStaleHoursMin}" Maximum="{Binding MaxStaleHoursMax}" FormatString="N0" AutomationProperties.Name="Maximum age of stale data (hours)"/>
        </StackPanel>
      </WrapPanel>
      <TextBlock Text="{Binding KolIntervalInfo}" FontSize="11" TextWrapping="Wrap" Opacity="0.7"/>
      <TextBlock Text="{Binding PricegunIntervalInfo}" FontSize="11" TextWrapping="Wrap" Opacity="0.7"/>

      <TextBlock Text="Daily" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding DailyKnucklebonesTargetInfo}" FontSize="12" Opacity="0.8"/>
      <NumericUpDown Width="240" HorizontalAlignment="Left" Value="{Binding DailyKnucklebonesTarget}" Minimum="{Binding DailyKnucklebonesTargetMin}" Maximum="{Binding DailyKnucklebonesTargetMax}" FormatString="N0"
                     AutomationProperties.Name="Daily knucklebones target"/>
      <TextBlock Text="{Binding DailyRestsInfo}" FontSize="12" Opacity="0.8"/>
      <NumericUpDown Width="240" HorizontalAlignment="Left" Value="{Binding DailyRests}" Minimum="{Binding DailyRestsMin}" Maximum="{Binding DailyRestsMax}" FormatString="N0"
                     AutomationProperties.Name="Rests per daily run"/>

      <TextBlock Text="Booze for the Daily tab (nothing is chosen for you)" FontSize="12"/>
      <ListBox ItemsSource="{Binding Booze.Items}" SelectedItem="{Binding Booze.Selected}" MaxHeight="120" AutomationProperties.Name="Daily booze list">
        <ListBox.ItemTemplate><DataTemplate x:DataType="local:DailyConsumable"><TextBlock Text="{Binding Label}"/></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Text="{Binding Booze.Item}" Watermark="Item id or exact name" Width="220" AutomationProperties.Name="Booze item"/>
        <NumericUpDown Value="{Binding Booze.Quantity}" Minimum="{Binding Booze.QuantityMin}" Maximum="{Binding Booze.QuantityMax}" Width="100" FormatString="N0"/>
        <Button Content="Add" Command="{Binding Booze.Add}"/>
        <Button Content="Remove selected" Command="{Binding Booze.Remove}"/>
      </StackPanel>
      <TextBlock Text="{Binding Booze.Message}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>

      <TextBlock Text="Spleen items for the Daily tab" FontSize="12"/>
      <ListBox ItemsSource="{Binding Spleen.Items}" SelectedItem="{Binding Spleen.Selected}" MaxHeight="120" AutomationProperties.Name="Daily spleen list">
        <ListBox.ItemTemplate><DataTemplate x:DataType="local:DailyConsumable"><TextBlock Text="{Binding Label}"/></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Text="{Binding Spleen.Item}" Watermark="Item id or exact name" Width="220" AutomationProperties.Name="Spleen item"/>
        <NumericUpDown Value="{Binding Spleen.Quantity}" Minimum="{Binding Spleen.QuantityMin}" Maximum="{Binding Spleen.QuantityMax}" Width="100" FormatString="N0"/>
        <Button Content="Add" Command="{Binding Spleen.Add}"/>
        <Button Content="Remove selected" Command="{Binding Spleen.Remove}"/>
      </StackPanel>
      <TextBlock Text="{Binding Spleen.Message}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>

      <TextBlock Text="Game and UI" FontWeight="SemiBold"/>
      <WrapPanel>
        <StackPanel Spacing="3" Width="240" Margin="0,0,12,8">
          <TextBlock Text="Turn budget (turns)" FontSize="12" Opacity="0.8"/>
          <NumericUpDown Value="{Binding TurnBudget}" Minimum="{Binding TurnBudgetMin}" Maximum="{Binding TurnBudgetMax}" FormatString="N0" AutomationProperties.Name="Turn budget (turns)"/>
        </StackPanel>
        <StackPanel Spacing="3" Width="240" Margin="0,0,12,8">
          <TextBlock Text="HP stop (% of max HP)" FontSize="12" Opacity="0.8"/>
          <NumericUpDown Value="{Binding HpStopPercent}" Minimum="{Binding HpStopPercentMin}" Maximum="{Binding HpStopPercentMax}" FormatString="N0" AutomationProperties.Name="HP stop (% of max HP)"/>
        </StackPanel>
        <StackPanel Spacing="3" Width="240" Margin="0,0,12,8">
          <TextBlock Text="Max combat rounds (the game ends a fight at 50)" FontSize="12" Opacity="0.8"/>
          <NumericUpDown Value="{Binding MaxCombatRounds}" Minimum="{Binding MaxCombatRoundsMin}" Maximum="{Binding MaxCombatRoundsMax}" FormatString="N0" AutomationProperties.Name="Max combat rounds (the game ends a fight at 50)"/>
        </StackPanel>
      </WrapPanel>
      <CheckBox IsChecked="{Binding ExperimentalTools}" Content="Show experimental tools (Arbitrage, clan lounge and stash, farm figures)"
                AutomationProperties.Name="Show experimental tools"/>
      <TextBlock IsVisible="{Binding ExperimentalFromEnvironment}" Text="KOLIBRI_EXPERIMENTAL is set: experimental tools are on."
                 FontSize="12" Opacity="0.8"/>
      <StackPanel Spacing="3" Width="240">
        <TextBlock Text="Theme (saved with the header button too)" FontSize="12" Opacity="0.8"/>
        <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" HorizontalAlignment="Stretch" AutomationProperties.Name="Theme"/>
      </StackPanel>
    </StackPanel>
</UserControl>
