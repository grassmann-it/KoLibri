<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <PackageId>KoLibri.LibKolibri</PackageId>
    <Description>Kingdom of Loathing connector for .NET 8: session and login, account reads, adventures and fights, item use and consumables, mall search and price-guarded buying, KMail, and the KoLmafia data snapshot. Building blocks for writing your own KoL tools. Early alpha.</Description>
    <PackageTags>kol;kingdom-of-loathing;kolmafia;connector;game-client;net8</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetPackOnBuild>false</TargetPackOnBuild>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Inside the KoLibri repository the core is a project reference, so a
         fresh clone builds without a NuGet feed. Outside the repository the
         published package is used instead. The path is resolved once, in
         MSBuild's own working directory. -->
    <KolArbitrageCoreProject>$(MSBuildThisFileDirectory)../../../KoLibri.Core/KoLibri.Core.csproj</KolArbitrageCoreProject>
    <HasKolArbitrageCoreProject Condition="Exists('$(KolArbitrageCoreProject)')">true</HasKolArbitrageCoreProject>
    <HasKolArbitrageCoreProject Condition="'$(HasKolArbitrageCoreProject)' == ''">false</HasKolArbitrageCoreProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(KolArbitrageCoreProject)"
                     Condition="'$(HasKolArbitrageCoreProject)' == 'true'" />
    <PackageReference Include="KoLibri.Core" Version="$(KoLibriVersion)"
                     Condition="'$(HasKolArbitrageCoreProject)' != 'true'" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
