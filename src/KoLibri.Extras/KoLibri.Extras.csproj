<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>KoLibri.Extras</RootNamespace>
    <!-- Market analysis and shop extras that are not part of the library promise (docs/lib-api-0.5.md §6.2).
         Not published on NuGet; used by the CLI. Only the public KoLibri API, no KoLibri.Core. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../KoLibri/KoLibri.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="KoLibri.Tests" />
    <InternalsVisibleTo Include="KoLibri.Core.Tests" />
  </ItemGroup>
</Project>
