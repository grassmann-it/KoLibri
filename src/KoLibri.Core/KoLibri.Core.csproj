<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <PackageId>KoLibri.Core</PackageId>
    <Description>Core layer for KoLibri (Kingdom of Loathing): KoL session and requests, adventure and combat steps, item and mall operations, KoLmafia data records. Used by KoLibri.LibKolibri; early alpha.</Description>
    <PackageTags>kol;kingdom-of-loathing;kolmafia;core;net8</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <TargetPackOnBuild>false</TargetPackOnBuild>
    <!-- Not a package in 0.5: bundled into KoLibri (src/KoLibri/KoLibri.csproj). -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Windows only at run time (guarded by OperatingSystem.IsWindows); wraps the local secret key with DPAPI. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="KoLibri.Core.Tests" />
    <!-- Transition (0.5): the KoLibri facade builds on Core internals until Core is folded into it. -->
    <InternalsVisibleTo Include="KoLibri" />
  </ItemGroup>
</Project>
