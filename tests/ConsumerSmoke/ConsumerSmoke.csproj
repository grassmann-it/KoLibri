<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="KoLibri.Core" Version="0.1.0-preview" />
    <PackageReference Include="KoLibri.LibKolibri" Version="0.1.0-preview" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)external/**/*" CopyToOutputDirectory="PreserveNewest" LinkBase="external" />
  </ItemGroup>
</Project>
