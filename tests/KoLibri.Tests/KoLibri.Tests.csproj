<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Only the 0.5 projects: these tests prove the public API is enough (no KoLibri.Core reference). -->
    <ProjectReference Include="../../src/KoLibri/KoLibri.csproj" />
    <ProjectReference Include="../../src/KoLibri.Safety/KoLibri.Safety.csproj" />
    <ProjectReference Include="../../src/KoLibri.Daily/KoLibri.Daily.csproj" />
    <ProjectReference Include="../../src/KoLibri.Extras/KoLibri.Extras.csproj" />
    <!-- The CLI runs against the same fake KoL (KolibriCli.OptionsOverride); it references no KoLibri.Core. -->
    <ProjectReference Include="../../tools/KolLibri.Cli/KolLibri.Cli.csproj" />
    <!-- The desktop tests (Desktop/) run the view models and windows against the same fake KoL; no KoLibri.Core. -->
    <ProjectReference Include="../../KoLibri.Desktop/KoLibri.Desktop.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)../../external/kolmafia-data/**/*" CopyToOutputDirectory="PreserveNewest" LinkBase="external/kolmafia-data" />
    <!-- Saved KoL pages the desktop tests replay (shared with the Core suite). -->
    <Content Include="$(MSBuildThisFileDirectory)../KoLibri.Core.Tests/Fixtures/**/*" CopyToOutputDirectory="PreserveNewest" LinkBase="Fixtures" />
  </ItemGroup>
</Project>
