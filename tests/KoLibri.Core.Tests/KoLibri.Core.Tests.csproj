<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/KoLibri.Core/KoLibri.Core.csproj" />
    <ProjectReference Include="../../src/LibKolibri/src/LibKolibri/LibKolibri.csproj" />
    <ProjectReference Include="../../tools/KolLibri.Mcp/KolLibri.Mcp.csproj" />
    <ProjectReference Include="../../tools/KolLibri.Cli/KolLibri.Cli.csproj" />
    <ProjectReference Include="../../KoLibri.Desktop/KoLibri.Desktop.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Content Include="Fixtures/Adventure/**/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures/Inventory/**/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures/Html/**/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(MSBuildThisFileDirectory)../../external/kolmafia-data/**/*" CopyToOutputDirectory="PreserveNewest" LinkBase="external/kolmafia-data" />
  </ItemGroup>
</Project>
