<Project>
  <PropertyGroup>
    <!-- Shared version for KoLibri, KoLibri.Safety, CLI, MCP, and Desktop. -->
    <KoLibriVersion>0.5.0</KoLibriVersion>
    <Version>$(KoLibriVersion)</Version>
    <Authors>KoLibri contributors</Authors>
    <RepositoryUrl>https://github.com/grassmann-it/KoLibri</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/grassmann-it/KoLibri</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)assets/kolibri-icon-512.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>
</Project>
